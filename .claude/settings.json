{
  "permissions": {
    "allow": [
      "Bash(bun run:*)",
      "Bash(bun install:*)",
      "Bash(bunx oxlint:*)",
      "Bash(bunx tsc:*)",
      "Bash(bunx vitest:*)",
      "Bash(bunx wrangler d1:*)",
      "Bash(node:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git show:*)",
      "Bash(curl:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(python3:*)",
      "mcp__shadcn",
      "mcp__playwright",
      "mcp__playwright-qa",
      "mcp__t3-code__t3_thread_read",
      "mcp__t3-code__t3_thread_list",
      "mcp__t3-code__t3_thread_search",
      "mcp__t3-code__t3_background_wait",
      "mcp__t3-code__list_scheduled_tasks",
      "mcp__t3-code__orchestrator_capabilities",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__claude-in-chrome__get_page_text",
      "mcp__claude-in-chrome__find",
      "mcp__claude-in-chrome__read_page",
      "mcp__ccd_pr__get_status",
      "mcp__ccd_session_mgmt__list_events",
      "mcp__terminal__read_terminal"
    ],
    "ask": [
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(bunx wrangler deploy:*)",
      "Bash(bunx wrangler secret:*)",
      "Bash(npx wrangler deploy:*)",
      "Bash(npx wrangler secret:*)",
      "Read(.dev.vars)"
    ]
  },
  "enabledMcpjsonServers": [
    "shadcn",
    "playwright",
    "better-auth"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/defaults.sh",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
