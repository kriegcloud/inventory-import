{
  "name": "@inventory/app",
  "version": "0.6.1",
  "private": true,
  "description": "Bulk import of inventory items from a messy .csv or .xlsx, with a review you can trust",
  "type": "module",
  "scripts": {
    "predev": "node scripts/migrate-local.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-production-identity.mjs",
    "build:report": "BUNDLE_REPORT=1 vite build && node scripts/bundle-report.mjs",
    "typecheck": "tsrs -b --fast",
    "test": "vitest run --project fast",
    "lint": "oxlint --quiet; lint=$?; oxlint --disable-nested-config --deny-warnings -c ../../.oxlintrc.shadcn.json src/web && exit $lint",
    "lint:shadcn": "oxlint --disable-nested-config --deny-warnings -c ../../.oxlintrc.shadcn.json src/web",
    "preview": "tsc -b && vite build && node scripts/check-production-identity.mjs && vite preview",
    "db:migrate": "node scripts/migrate-local.mjs",
    "db:reset": "node -e \"require('node:fs').rmSync('.wrangler/state',{recursive:true,force:true})\" && node scripts/migrate-local.mjs",
    "lighthouse": "bash scripts/lighthouse.sh",
    "pregrid:keys": "node scripts/migrate-local.mjs",
    "grid:keys": "node scripts/grid-keys.mjs",
    "dev:portless": "node scripts/migrate-local.mjs && portless inventory vite",
    "dev:https": "node scripts/migrate-local.mjs && node scripts/dev-https.mjs",
    "typecheck:tsc": "effect-tsgo tsc -b",
    "check:strict": "beep-cli quality strict strict-ceiling.json",
    "telemetry": "node scripts/telemetry.mjs",
    "telemetry:down": "node scripts/telemetry.mjs down",
    "auth:schema": "node scripts/auth-schema.mjs",
    "check": "tsrs -b --fast && beep-cli quality strict strict-ceiling.json",
    "test:slow": "vitest run --project slow",
    "test:all": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@beep/better-auth": "workspace:*",
    "@beep/csv": "workspace:*",
    "@beep/d1": "workspace:*",
    "@beep/openrouter": "workspace:*",
    "@beep/schema": "workspace:*",
    "@beep/unsafe-assert": "workspace:*",
    "@dnd-kit/core": "catalog:",
    "@dnd-kit/modifiers": "catalog:",
    "@dnd-kit/sortable": "catalog:",
    "@dnd-kit/utilities": "catalog:",
    "@effect/atom-react": "catalog:",
    "@effect/sql-d1": "catalog:",
    "@floating-ui/react-dom": "catalog:",
    "@fontsource-variable/ibm-plex-sans": "catalog:",
    "@fontsource-variable/jetbrains-mono": "catalog:",
    "@hookform/resolvers": "^7.0.9",
    "@inventory/access-contract": "workspace:*",
    "@inventory/access-host": "workspace:*",
    "@inventory/access-model": "workspace:*",
    "@inventory/access-web": "workspace:*",
    "@inventory/catalog-contract": "workspace:*",
    "@inventory/catalog-host": "workspace:*",
    "@inventory/catalog-model": "workspace:*",
    "@inventory/catalog-web": "workspace:*",
    "@inventory/client": "workspace:*",
    "@inventory/kernel": "workspace:*",
    "@inventory/review": "workspace:*",
    "@inventory/ui": "workspace:*",
    "@shadcn/react": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "better-auth": "catalog:",
    "class-variance-authority": "catalog:",
    "cmdk": "catalog:",
    "cn": "catalog:",
    "date-fns": "^4.4.0",
    "effect": "catalog:",
    "embla-carousel-react": "catalog:",
    "input-otp": "catalog:",
    "lucide-react": "catalog:",
    "radix-ui": "catalog:",
    "react": "catalog:",
    "react-day-picker": "catalog:",
    "react-dom": "catalog:",
    "react-grab": "^0.2.0",
    "react-hook-form": "catalog:",
    "react-resizable-panels": "catalog:",
    "recharts": "catalog:",
    "sonner": "catalog:",
    "tw-animate-css": "catalog:",
    "vaul": "catalog:"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87-e1c3e6d",
    "@alchemy.run/test": "2.0.0-beta.87",
    "@beep/infra": "workspace:*",
    "@cloudflare/vite-plugin": "^1.70.2",
    "@cloudflare/workers-types": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@shadcn/lint": "0.2.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/compression": "^1.8.1",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.3.0",
    "alchemy": "2.0.0-beta.87-e1c3e6d",
    "compression": "1.8.2",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright-core": "1.65.1",
    "rollup-plugin-visualizer": "7.3.0",
    "tailwindcss": "catalog:",
    "tsrs": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.4.0",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
