{
  "name": "inventory",
  "private": true,
  "description": "Bulk import of inventory items from a messy .csv or .xlsx, with a review you can trust",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/drivers/*",
    "packages/foundation/*/*"
  ],
  "type": "module",
  "scripts": {
    "check": "turbo run check lint test //#format:check //#docs:check //#keys:check //#vendor:check //#ceilings:check //#boundaries:check",
    "check:full": "turbo run check lint test test:slow build //#format:check //#docs:check //#keys:check //#vendor:check //#ceilings:check //#boundaries:check",
    "dev": "bun run --cwd apps/inventory dev",
    "build": "turbo run build",
    "preview": "bun run --cwd apps/inventory preview",
    "test": "turbo run test test:slow",
    "lint": "turbo run lint",
    "typecheck": "turbo run check",
    "db:reset": "bun run --cwd apps/inventory db:reset",
    "auth:schema": "bun run --cwd apps/inventory auth:schema",
    "telemetry": "bun run --cwd apps/inventory telemetry",
    "telemetry:down": "bun run --cwd apps/inventory telemetry:down",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "docs:check": "bash scripts/docs-check.sh",
    "deps:lint": "syncpack lint",
    "deps:outdated": "syncpack update --check",
    "prepare": "effect-tsgo patch --typescript --oxlint --tsrs",
    "keys:check": "bash scripts/keys-check.sh",
    "vendor:check": "node scripts/vendor-check.mjs",
    "ceilings:check": "node scripts/check-ceilings.mjs",
    "boundaries:check": "node scripts/check-boundaries.mjs"
  },
  "devDependencies": {
    "@effect/tsgo": "0.70.0",
    "oxfmt": "^0.78.0",
    "oxlint": "1.93.0",
    "syncpack": "^15.3.3",
    "turbo": "2.11.11",
    "typescript": "~7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ]
}
