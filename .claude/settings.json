{
  "permissions": {
    "allow": [
      "Bash(bun run:*)",
      "Bash(bun install:*)",
      "Bash(bunx oxlint:*)",
      "Bash(bunx tsc:*)",
      "Bash(bunx vitest:*)",
      "Bash(bunx wrangler d1:*)",
      "Bash(node:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git show:*)",
      "Bash(curl:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(python3:*)",
      "mcp__shadcn",
      "mcp__playwright",
      "mcp__playwright-qa"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(bunx wrangler deploy:*)",
      "Bash(bunx wrangler secret:*)",
      "Bash(npx wrangler deploy:*)",
      "Bash(npx wrangler secret:*)",
      "Read(.dev.vars)"
    ]
  },
  "enabledMcpjsonServers": [
    "shadcn",
    "playwright",
    "better-auth"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/defaults.sh",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
