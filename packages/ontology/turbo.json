{
  "$schema": "../../node_modules/turbo/schema.json",
  "extends": ["//"],
  "tasks": {
    // Two places outside the package are read by the tests: the decision log, whose headings say which decisions are
    // answered (gate 4's rule C12; report 14 section 6.10), and the party slice's question folder, whose queries and
    // fixtures gate 8 reads through `?raw` imports (decision 36). Neither is in the package nor a dependency's
    // source, so each is named here, or an edit to one of its files, or its removal, replays the last pass. The
    // kernel's literal is covered by the dependency edge, and the exception list and the thread's fixtures by
    // `$TURBO_DEFAULT$`.
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vitest.shared.ts",
        "$TURBO_ROOT$/vitest.retries.ts",
        "$TURBO_ROOT$/explorations/erp-ontology/DECISIONS.md",
        "$TURBO_ROOT$/explorations/erp-ontology/assets/requirements/cq/**"
      ]
    },
    // Gate 9, the reasoner (report 14 sections 6.9 and 6.10). Never cached: its pass depends on the Java installed
    // and on the jar kept outside the repository, which no input can stand for, so a replay would skip the script's
    // own check of both. Every `bun run check:full` starts it. Not in `bun run check`, which needs no Java.
    "reason": { "dependsOn": ["transit"], "cache": false }
  }
}
