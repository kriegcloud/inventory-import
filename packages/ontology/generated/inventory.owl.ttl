    owl:disjointWith gist:PhysicalAddress .

gist:Event a owl:Class .

gist:LivingThing a owl:Class ;
    rdfs:subClassOf gist:PhysicalIdentifiableItem .

gist:Organization a owl:Class ;
    owl:disjointWith gist:PhysicalIdentifiableItem .

gist:Person a owl:Class ;
    rdfs:subClassOf gist:LivingThing .

gist:PhysicalAddress a owl:Class ;
    rdfs:subClassOf gist:Address .

gist:PhysicalIdentifiableItem a owl:Class .

gist:TemporalRelation a owl:Class .

inv:AgentRun a owl:Class ;
    rdfs:subClassOf gist:Event ;
    skos:prefLabel "Agent run"@en ;
    skos:definition "An event in which a software agent acts for one signed-in member, never above that member's role nor above its own role cap."@en .

inv:AuditEntry a owl:Class ;
    rdfs:subClassOf gist:Content ;
    skos:prefLabel "Audit entry"@en ;
    skos:altLabel "Activity"@en ;
    skos:definition "A record of one change to a tenant's data, written in the same batch as the change, naming who made it, the agent that acted for them if any, and what was done."@en .

inv:ContactAssignment a owl:Class ;
    rdfs:subClassOf gist:Assignment ;
    skos:prefLabel "Contact assignment"@en ;
    skos:definition "A relationship naming one person to reach at one account for a stated purpose using a particular contact point."@en .

inv:ContactPoint a owl:Class ;
    rdfs:subClassOf gist:ElectronicAddress ;
    skos:prefLabel "Contact point"@en ;
    skos:definition "An electronic address, an email address or a telephone number, at which a party is reached."@en .

inv:Grant a owl:Class ;
    rdfs:subClassOf gist:Assignment ;
    skos:prefLabel "Grant"@en ;
    skos:definition "An assignment of one role to one member at one scope (the whole tenant, one site or one field), made by a member allowed to make it."@en .

inv:IdentityDecision a owl:Class ;
    rdfs:subClassOf gist:Determination ;
    skos:prefLabel "Identity decision"@en ;
    skos:definition "A determination by a member that two source records the tenant holds describe the same party, or different parties, resting on the evidence it cites."@en .

inv:IdentityEvidence a owl:Class ;
    rdfs:subClassOf gist:Content ;
    skos:prefLabel "Identity evidence"@en ;
    skos:definition "A statement of one observed likeness or difference between two source records the tenant holds, such as a shared tax number or names one letter apart, cited by an identity decision."@en .

inv:Member a owl:Class ;
    rdfs:subClassOf gist:TemporalRelation ;
    skos:prefLabel "Member"@en ;
    skos:definition "A relationship between one person and one tenant, made when the person is invited or added and kept after it is removed or revoked, that lets the person act in the tenant's workspace or, where it names one, in that source's workspace, until it is removed and, where it states a stage, while that stage is active."@en .

inv:ModelCall a owl:Class ;
    rdfs:subClassOf gist:Event ;
    skos:prefLabel "Model call"@en ;
    skos:definition "An event in which the app asks a language model one question for a tenant, taken from that tenant's daily allowance before it is asked."@en .

inv:Organization a owl:Class ;
    rdfs:subClassOf inv:Party ,
        gist:Organization ;
    skos:prefLabel "Organization"@en ;
    skos:definition "An organized body of people or of other organizations formed for a purpose, such as a company the tenant buys from, sells to, ships with or has goods made by, or the tenant itself."@en .

inv:Party a owl:Class ;
    skos:prefLabel "Party"@en ;
    skos:definition "An agent that is either a human being or an organized body, named so that the properties persons and organizations share have one range."@en .

inv:Person a owl:Class ;
    rdfs:subClassOf inv:Party ,
        gist:Person ;
    skos:prefLabel "Person"@en ;
    skos:definition "A human being."@en .

inv:PostalAddress a owl:Class ;
    rdfs:subClassOf gist:PhysicalAddress ;
    skos:prefLabel "Postal address"@en ;
    skos:definition "A physical address, written as lines, locality, region, postal code and country, that a tenant's record of a party gives for receiving or sending goods, documents or invoices."@en .

inv:Role a owl:Class ;
    skos:prefLabel "Role"@en ;
    skos:definition "A named level of access a grant gives a member, such as viewer, editor or admin."@en .

inv:SignInAccount a owl:Class ;
    rdfs:subClassOf gist:Content ;
    skos:prefLabel "Sign-in account"@en ;
    skos:definition "A credential record that lets one person sign in to an application, this one or a source such as Sutton, before any organization is chosen."@en .

inv:SourceRecord a owl:Class ;
    rdfs:subClassOf gist:Content ;
    skos:prefLabel "Source record"@en ;
    skos:definition "Content an external system or the tenant holds about one thing, named by its system, its record type and its opaque id, so that a later read of the same record is the same source record; the tenant's assertions about that thing, such as its customer and vendor flags, sit on it."@en .

inv:Tenant a owl:Class ;
    rdfs:subClassOf inv:Organization ;
    skos:prefLabel "Tenant"@en ;
    skos:definition "An organization for which this application keeps a workspace, whose records are scoped to it and hidden from every other organization."@en .

inv:accountStatus a owl:ObjectProperty ;
    rdfs:subPropertyOf gist:isCategorizedBy ;
    rdfs:domain inv:SourceRecord ;
    skos:prefLabel "account status"@en ;
    skos:definition "Links the tenant's record of a party to whether the tenant still trades with the party or has archived the record."@en .

inv:addressPurpose a owl:ObjectProperty ;
    rdfs:subPropertyOf gist:isCategorizedBy ;
    rdfs:domain inv:PostalAddress ;
    skos:prefLabel "address purpose"@en ;
    skos:definition "Links a postal address to a purpose its record types it for, such as billing, shipping or ship from; one address may have several."@en .

inv:assignmentPoint a owl:ObjectProperty ;
    rdfs:domain inv:ContactAssignment ;
    rdfs:range inv:ContactPoint ;
    skos:prefLabel "assignment point"@en ;
    skos:definition "Links a contact assignment to the contact point to use for it."@en .

inv:callPurpose a owl:ObjectProperty ;
    rdfs:subPropertyOf gist:isCategorizedBy ;
    rdfs:domain inv:ModelCall ;
    skos:prefLabel "call purpose"@en ;
    skos:definition "Links a model call to what it is for: reading a table request, checking the key, or suggesting fixes for an import."@en .

inv:calledFor a owl:ObjectProperty ;
    rdfs:domain inv:ModelCall ;
    rdfs:range inv:Member ;
    skos:prefLabel "called for"@en ;
    skos:definition "Links a model call to the member whose action asked for it."@en .

inv:citesEvidence a owl:ObjectProperty ;
    rdfs:range inv:IdentityEvidence ;
    skos:prefLabel "cites evidence"@en ;
    skos:definition "Links a decision to a piece of evidence it rests on."@en .

inv:contactAccount a owl:ObjectProperty ;
    rdfs:domain inv:ContactAssignment ;
    rdfs:range inv:Party ;
    skos:prefLabel "contact account"@en ;
    skos:definition "Links a contact assignment to the account at which its person serves its purpose, an organization or a person."@en .

inv:contactAt a owl:ObjectProperty ;
    rdfs:domain inv:SourceRecord ;
    rdfs:range inv:SourceRecord ;
    skos:prefLabel "contact at"@en ;
    skos:definition "Links the tenant's record of a contact to the tenant's record of the company the contact belongs to, stating no purpose."@en .

inv:contactOwner a owl:ObjectProperty ;
    rdfs:domain inv:SourceRecord ;
    rdfs:range inv:Member ;
    skos:prefLabel "contact owner"@en ;
    skos:definition "Links the tenant's record of a contact to a member of the tenant who owns the contact."@en .

inv:contactPerson a owl:ObjectProperty ;
    rdfs:domain inv:ContactAssignment ;
    rdfs:range inv:Person ;
    skos:prefLabel "contact person"@en ;
    skos:definition "Links a contact assignment to the person to reach on it."@en .

inv:contactPointKind a owl:ObjectProperty ;
    rdfs:subPropertyOf gist:isCategorizedBy ;
    rdfs:domain inv:ContactPoint ;
    skos:prefLabel "contact point kind"@en ;
    skos:definition "Links a contact point to what kind of electronic address it is: an email address or a telephone number."@en .

inv:contactType a owl:ObjectProperty ;
    rdfs:subPropertyOf gist:isCategorizedBy ;
    rdfs:domain inv:SourceRecord ;
    skos:prefLabel "contact type"@en ;
    skos:definition "Links the tenant's record of a contact to the kind the tenant files the contact under."@en .

inv:decidedBy a owl:ObjectProperty ;
    rdfs:domain inv:IdentityDecision ;
    rdfs:range inv:Member ;
    skos:prefLabel "decided by"@en ;
    skos:definition "Links an identity decision to the member who made it."@en .

inv:decidesOn a owl:ObjectProperty ;
    rdfs:domain inv:IdentityDecision ;
    rdfs:range inv:SourceRecord ;
    skos:prefLabel "decides on"@en ;
    skos:definition "Links an identity decision to one of the two source records it compares."@en .

inv:defaultFor a owl:ObjectProperty ;
    rdfs:domain inv:PostalAddress ;
    skos:prefLabel "default for"@en ;
    skos:definition "Links a postal address to a purpose for which it is the one used when an order names no other."@en .

inv:grantScope a owl:ObjectProperty ;
    rdfs:subPropertyOf gist:isCategorizedBy ;
    rdfs:domain inv:Grant ;
    skos:prefLabel "grant scope"@en ;
    skos:definition "Links a grant to the kind of scope it applies to."@en .

inv:grantedTo a owl:ObjectProperty ;
    rdfs:domain inv:Grant ;
    rdfs:range inv:Member ;
    skos:prefLabel "granted to"@en ;
    skos:definition "Links a grant to the member who holds it."@en .

inv:grantsRole a owl:ObjectProperty ;
    rdfs:domain inv:Grant ;
    rdfs:range inv:Role ;
    skos:prefLabel "grants role"@en ;
    skos:definition "Links a grant to the role it gives."@en .

inv:hasContactPoint a owl:ObjectProperty ;
    rdfs:subPropertyOf gist:hasAddress ;
    rdfs:domain inv:SourceRecord ;
    rdfs:range inv:ContactPoint ;
    skos:prefLabel "has contact point"@en ;
    skos:definition "Links the tenant's record of a party to an email address or telephone number that record gives."@en .

inv:hasPostalAddress a owl:ObjectProperty ;
    rdfs:subPropertyOf gist:hasAddress ;
    rdfs:domain inv:SourceRecord ;
    rdfs:range inv:PostalAddress ;
    skos:prefLabel "has postal address"@en ;
    skos:definition "Links the tenant's record of a party to a postal address that record gives."@en .

inv:identityOutcome a owl:ObjectProperty ;
    rdfs:subPropertyOf gist:isCategorizedBy ;
    rdfs:domain inv:IdentityDecision ;
    skos:prefLabel "identity outcome"@en ;
    skos:definition "Links an identity decision to what it found: the two records denote one party, or two."@en .

inv:inTenant a owl:ObjectProperty ;
    rdfs:range inv:Tenant ;
    skos:prefLabel "in tenant"@en ;
    skos:definition "The tenant whose workspace holds this record, not the owner of the body it describes."@en .

inv:maxRole a owl:ObjectProperty ;
    rdfs:domain inv:AgentRun ;
    rdfs:range inv:Role ;
    skos:prefLabel "max role"@en ;
    skos:definition "Links an agent run to the highest role it may act with, whatever the role of the member it acts for."@en .

inv:memberAccount a owl:ObjectProperty ;
    rdfs:domain inv:Member ;
    rdfs:range inv:SignInAccount ;
    skos:prefLabel "member account"@en ;
    skos:definition "Links a membership to the sign-in account its person signs in with to act under that membership."@en .

inv:memberContactPoint a owl:ObjectProperty ;
    rdfs:subPropertyOf gist:hasAddress ;
    rdfs:domain inv:Member ;
    rdfs:range inv:ContactPoint ;
    skos:prefLabel "member contact point"@en ;
    skos:definition "Links a membership to an email address or telephone number that its profile in the tenant gives for its person, such as a personal email or phone."@en .

inv:membershipIn a owl:ObjectProperty ;
    rdfs:domain inv:Member ;
    rdfs:range inv:Tenant ;
    skos:prefLabel "membership in"@en ;
    skos:definition "Links a membership to the tenant it belongs to, in whose workspace, or in a source's workspace it names, it lets its person act."@en .

inv:membershipOf a owl:ObjectProperty ;
    rdfs:domain inv:Member ;
    rdfs:range inv:Person ;
    skos:prefLabel "membership of"@en ;
    skos:definition "Links a membership to the human who holds it, independently of any account."@en .

inv:membershipStatus a owl:ObjectProperty ;
    rdfs:subPropertyOf gist:isCategorizedBy ;
    rdfs:domain inv:Member ;
    skos:prefLabel "membership status"@en ;
    skos:definition "Links a membership to the stage it stands at: pending, active, suspended or revoked."@en .

inv:membershipWorkspace a owl:ObjectProperty ;
    rdfs:domain inv:Member ;
    rdfs:range inv:SourceRecord ;
    skos:prefLabel "membership workspace"@en ;
    skos:definition "Links a membership to the source's record of the workspace it lets its person act in, stated only where that workspace is another system's, such as a Sutton organization's."@en .

inv:primaryContact a owl:ObjectProperty ;
    rdfs:domain inv:SourceRecord ;
    rdfs:range inv:SourceRecord ;
    skos:prefLabel "primary contact"@en ;
    skos:definition "Links the tenant's record of a company to the tenant's record of the contact it names first."@en .

inv:recordOf a owl:ObjectProperty ;
    rdfs:subPropertyOf gist:isAbout ;
    rdfs:domain inv:SourceRecord ;
    rdfs:range inv:Party ;
    skos:prefLabel "record of"@en ;
    skos:definition "Links a source record to the party it was captured about: a person, or an organization."@en .

inv:recordedActor a owl:ObjectProperty ;
    rdfs:domain inv:AuditEntry ;
    rdfs:range inv:Member ;
    skos:prefLabel "recorded actor"@en ;
    skos:definition "Links an audit entry to the member it names as having made the change."@en .

inv:recordedAgentRun a owl:ObjectProperty ;
    rdfs:domain inv:AuditEntry ;
    rdfs:range inv:AgentRun ;
    skos:prefLabel "recorded agent run"@en ;
    skos:definition "Links an audit entry to the agent run that made the change for the member it names, when an agent did."@en .

inv:servesPurpose a owl:ObjectProperty ;
    rdfs:subPropertyOf gist:isCategorizedBy ;
    rdfs:domain inv:ContactAssignment ;
    skos:prefLabel "serves purpose"@en ;
    skos:definition "Links a contact assignment to the business exchange for which to reach its person at its account using its point."@en .

gist:hasAddress a owl:ObjectProperty .

gist:isAbout a owl:ObjectProperty .

gist:isCategorizedBy a owl:ObjectProperty .

inv:accountEmail a owl:DatatypeProperty ;
    rdfs:domain inv:SignInAccount ;
    rdfs:range xsd:string ;
    skos:prefLabel "account email"@en ;
    skos:definition "The email a sign-in account signs in with, compared whatever its case."@en .

inv:action a owl:DatatypeProperty ;
    rdfs:domain inv:AuditEntry ;
    rdfs:range xsd:string ;
    skos:prefLabel "action"@en ;
    skos:definition "What was done in the change an audit entry records, in a few words a person reads."@en .

inv:addressLines a owl:DatatypeProperty ;
    rdfs:domain inv:PostalAddress ;
    rdfs:range xsd:string ;
    skos:prefLabel "address lines"@en ;
    skos:definition "The street lines of a postal address, in order and as written, one line break between two lines."@en .

inv:agentName a owl:DatatypeProperty ;
    rdfs:domain inv:AgentRun ;
    rdfs:range xsd:string ;
    skos:prefLabel "agent name"@en ;
    skos:definition "The agent's name as people read it in the activity list, such as \"Assistant\"."@en .

inv:calledAt a owl:DatatypeProperty ;
    rdfs:domain inv:ModelCall ;
    rdfs:range xsd:dateTime ;
    skos:prefLabel "called at"@en ;
    skos:definition "When a model call was taken from the tenant's daily allowance."@en .

inv:capturedAt a owl:DatatypeProperty ;
    rdfs:domain inv:SourceRecord ;
    rdfs:range xsd:dateTime ;
    skos:prefLabel "captured at"@en ;
    skos:definition "The instant a source record was last read from its system: one value, which each later read of the same record replaces."@en .

inv:contactValue a owl:DatatypeProperty ;
    rdfs:domain inv:ContactPoint ;
    rdfs:range xsd:string ;
    skos:prefLabel "contact value"@en ;
    skos:definition "The text of an email address or telephone number, as written in the source."@en .

inv:countryCode a owl:DatatypeProperty ;
    rdfs:domain inv:PostalAddress ;
    rdfs:range xsd:string ;
    skos:prefLabel "country code"@en ;
    skos:definition "The country of a postal address as a two-letter ISO 3166 code, stated only once a person accepts the code read from the source's own text."@en .

inv:eventTime a owl:DatatypeProperty ;
    rdfs:subPropertyOf gist:atDateTime ;
    rdfs:range xsd:dateTime ;
    skos:prefLabel "event time"@en ;
    skos:definition "The instant at which an event occurred, as its record states it."@en .

inv:evidenceText a owl:DatatypeProperty ;
    rdfs:domain inv:IdentityEvidence ;
    rdfs:range xsd:string ;
    skos:prefLabel "evidence text"@en ;
    skos:definition "The evidence in a sentence a person reads, naming the two values compared."@en .

inv:extension a owl:DatatypeProperty ;
    rdfs:domain inv:ContactPoint ;
    rdfs:range xsd:string ;
    skos:prefLabel "extension"@en ;
    skos:definition "The extension to dial after a telephone number, as written in the source."@en .

inv:familyName a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    skos:prefLabel "family name"@en ;
    skos:definition "A person's family name as a record or a membership's profile writes it."@en .

inv:givenName a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    skos:prefLabel "given name"@en ;
    skos:definition "A person's given name as a record or a membership's profile writes it."@en .

inv:isCustomer a owl:DatatypeProperty ;
    rdfs:domain inv:SourceRecord ;
    rdfs:range xsd:boolean ;
    skos:prefLabel "is customer"@en ;
    skos:altLabel "Buyer"@en ,
        "Client"@en ,
        "Customer"@en ;
    skos:definition "Whether the tenant's record of a trading account, one whose source has a trading-role field such as a Sutton company's, states that the party buys from the tenant: true or false on every such stored record, and stated on no other record."@en .

inv:isVendor a owl:DatatypeProperty ;
    rdfs:domain inv:SourceRecord ;
    rdfs:range xsd:boolean ;
    skos:prefLabel "is vendor"@en ;
    skos:altLabel "Supplier"@en ,
        "Vendor"@en ;
    skos:definition "Whether the tenant's record of a trading account, one whose source has a trading-role field such as a Sutton company's, states that the party sells to the tenant: true or false on every such stored record, and stated on no other record."@en .

inv:jobTitle a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    skos:prefLabel "job title"@en ;
    skos:definition "The title of a person's job at the organization a record or a membership names, as written."@en .

inv:joinedAt a owl:DatatypeProperty ;
    rdfs:domain inv:Member ;
    rdfs:range xsd:dateTime ;
    skos:prefLabel "joined at"@en ;
    skos:definition "When the person could first act in the membership, as its record states it: for this app's members the moment an admin added them, for an invitee the moment the invitation was accepted."@en .

inv:locality a owl:DatatypeProperty ;
    rdfs:domain inv:PostalAddress ;
    rdfs:range xsd:string ;
    skos:prefLabel "locality"@en ;
    skos:definition "The town or city of a postal address, as written."@en .

inv:middleName a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    skos:prefLabel "middle name"@en ;
    skos:definition "A person's middle name as a record or a membership's profile writes it."@en .

inv:name a owl:DatatypeProperty ;
    rdfs:subPropertyOf gist:name ;
    rdfs:range xsd:string ;
    skos:prefLabel "name"@en ;
    skos:definition "The name people read for a party, a membership, a record or a place, which is never unique and never decides identity or permission."@en .

inv:postalCode a owl:DatatypeProperty ;
    rdfs:domain inv:PostalAddress ;
    rdfs:range xsd:string ;
    skos:prefLabel "postal code"@en ;
    skos:definition "The postal code of a postal address, kept as text so leading zeros survive."@en .

inv:profileImage a owl:DatatypeProperty ;
    rdfs:domain inv:Member ;
    rdfs:range xsd:string ;
    skos:prefLabel "profile image"@en ;
    skos:definition "The picture the profile of a membership shows for its person, as the source gives it, such as a link to an image file."@en .

inv:profileText a owl:DatatypeProperty ;
    rdfs:domain inv:Member ;
    rdfs:range xsd:string ;
    skos:prefLabel "profile text"@en ;
    skos:altLabel "About"@en ;
    skos:definition "The text a person writes about themselves on the profile of one membership, as written in the source."@en .

inv:recordedAt a owl:DatatypeProperty ;
    rdfs:domain inv:AuditEntry ;
    rdfs:range xsd:dateTime ;
    skos:prefLabel "recorded at"@en ;
    skos:definition "The instant at which an audit entry was written."@en .

inv:region a owl:DatatypeProperty ;
    rdfs:domain inv:PostalAddress ;
    rdfs:range xsd:string ;
    skos:prefLabel "region"@en ;
    skos:definition "The state, province or other region of a postal address, as written."@en .

inv:sourceId a owl:DatatypeProperty ;
    rdfs:domain inv:SourceRecord ;
    rdfs:range xsd:string ;
    skos:prefLabel "source id"@en ;
    skos:definition "The opaque id the external system gives a source record, kept exactly as written."@en .

inv:sourceSystem a owl:DatatypeProperty ;
    rdfs:domain inv:SourceRecord ;
    rdfs:range xsd:string ;
    skos:prefLabel "source system"@en ;
    skos:definition "The external system a source record was read from, as written."@en .

inv:sourceType a owl:DatatypeProperty ;
    rdfs:domain inv:SourceRecord ;
    rdfs:range xsd:string ;
    skos:prefLabel "source type"@en ;
    skos:definition "The record type the external system gives a source record, as written."@en .

