{
  "name": "@inventory/access-web",
  "version": "0.0.0",
  "private": true,
  "description": "The screens of who may do what: the session as the browser knows it, sign-in, the People page and the audit trail's events",
  "license": "MIT",
  "type": "module",
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    "./Access": "./src/Access.runtime.ts",
    "./Session": "./src/Session.atoms.ts",
    "./SignIn": "./src/SignIn.screen.tsx",
    "./People": "./src/People.screen.tsx",
    "./AuditEvents": "./src/AuditEvents.screen.tsx"
  },
  "scripts": {
    "check": "tsrs -p tsconfig.json && beep-cli quality strict strict-ceiling.json",
    "lint": "oxlint --quiet src; lint=$?; oxlint --disable-nested-config --deny-warnings -c ../../../.oxlintrc.shadcn.json src && exit $lint"
  },
  "dependencies": {
    "@beep/better-auth": "workspace:*",
    "@beep/identity": "workspace:*",
    "@effect/atom-react": "catalog:",
    "@inventory/access-contract": "workspace:*",
    "@inventory/client": "workspace:*",
    "@inventory/kernel": "workspace:*",
    "@inventory/ui": "workspace:*",
    "effect": "catalog:",
    "sonner": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "oxlint": "catalog:",
    "tsrs": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "beep": {
    "family": "context",
    "context": "access",
    "layer": "web"
  }
}
