{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "semi": false,
  "singleQuote": false,
  "trailingComma": "none",
  "ignorePatterns": [
    "apps/inventory/src/web/components/ui/**",
    "apps/inventory/src/web/shadcn-utilities.css",
    "**/dist/**",
    "apps/inventory/migrations/**",
    "bun.lock",
    "**/*.md",
    "docs/**",
    "explorations/**",
    "goals/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".turbo/**",
    "**/.turbo/**",
    "**/.wrangler/**"
  ]
}
