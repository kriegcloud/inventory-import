gist:Assignment a owl:Class ;
    rdfs:subClassOf gist:TemporalRelation .

gist:Content a owl:Class ;
    owl:disjointWith gist:Organization ,
        gist:PhysicalIdentifiableItem .

gist:LivingThing a owl:Class ;
    rdfs:subClassOf gist:PhysicalIdentifiableItem .

gist:Organization a owl:Class ;
    owl:disjointWith gist:PhysicalIdentifiableItem .

gist:Person a owl:Class ;
    rdfs:subClassOf gist:LivingThing .

gist:PhysicalIdentifiableItem a owl:Class .

gist:TemporalRelation a owl:Class .

inv:AuditEntry a owl:Class ;
    rdfs:subClassOf gist:Content ;
    skos:prefLabel "Audit entry"@en ;
    skos:altLabel "Activity"@en ;
    skos:definition "A record of one change to a tenant's data, written in the same batch as the change, naming who made it, the agent that acted for them if any, and what was done."@en .

inv:Grant a owl:Class ;
    rdfs:subClassOf gist:Assignment ;
    skos:prefLabel "Grant"@en ;
    skos:definition "An assignment of one role to one member at one scope (the whole tenant, one site or one field), made by a member allowed to make it."@en .

inv:Member a owl:Class ;
    rdfs:subClassOf gist:TemporalRelation ;
    skos:prefLabel "Member"@en ;
    skos:definition "A relationship between one person and one tenant that lets the person act in the tenant's workspace from the day it is made until it is removed."@en .

inv:Organization a owl:Class ;
    rdfs:subClassOf inv:Party ,
        gist:Organization ;
    skos:prefLabel "Organization"@en ;
    skos:definition "An organized body of people or of other organizations formed for a purpose, such as a company the tenant buys from, sells to, ships with or has goods made by, or the tenant itself."@en .

inv:Party a owl:Class ;
    skos:prefLabel "Party"@en ;
    skos:definition "An agent that is either a human being or an organized body, named so that the properties persons and organizations share have one range."@en .

inv:Person a owl:Class ;
    rdfs:subClassOf inv:Party ,
        gist:Person ;
    skos:prefLabel "Person"@en ;
    skos:definition "A human being."@en .

inv:Role a owl:Class ;
    skos:prefLabel "Role"@en ;
    skos:definition "A named level of access a grant gives a member, such as viewer, editor or admin."@en .

inv:SourceRecord a owl:Class ;
    rdfs:subClassOf gist:Content ;
    skos:prefLabel "Source record"@en ;
    skos:definition "Content an external system or the tenant holds about one thing, named by its system, its record type and its opaque id, so that a later read of the same record is the same source record; the tenant's assertions about that thing, such as its customer and vendor flags, sit on it."@en .

inv:Tenant a owl:Class ;
    rdfs:subClassOf inv:Organization ;
    skos:prefLabel "Tenant"@en ;
    skos:definition "An organization for which this application keeps a workspace, whose records are scoped to it and hidden from every other organization."@en .

inv:grantScope a owl:ObjectProperty ;
    rdfs:subPropertyOf gist:isCategorizedBy ;
    rdfs:domain inv:Grant ;
    skos:prefLabel "grant scope"@en ;
    skos:definition "Links a grant to the kind of scope it applies to."@en .

inv:grantedTo a owl:ObjectProperty ;
    rdfs:domain inv:Grant ;
    rdfs:range inv:Member ;
    skos:prefLabel "granted to"@en ;
    skos:definition "Links a grant to the member who holds it."@en .

inv:grantsRole a owl:ObjectProperty ;
    rdfs:domain inv:Grant ;
    rdfs:range inv:Role ;
    skos:prefLabel "grants role"@en ;
    skos:definition "Links a grant to the role it gives."@en .

inv:inTenant a owl:ObjectProperty ;
    rdfs:range inv:Tenant ;
    skos:prefLabel "in tenant"@en ;
    skos:definition "The tenant whose workspace holds this record, not the owner of the body it describes."@en .

inv:membershipIn a owl:ObjectProperty ;
    rdfs:domain inv:Member ;
    rdfs:range inv:Tenant ;
    skos:prefLabel "membership in"@en ;
    skos:definition "Links a membership to the tenant it lets its person act in."@en .

inv:membershipOf a owl:ObjectProperty ;
    rdfs:domain inv:Member ;
    rdfs:range inv:Person ;
    skos:prefLabel "membership of"@en ;
    skos:definition "Links a membership to the human who holds it, independently of any account."@en .

inv:recordOf a owl:ObjectProperty ;
    rdfs:subPropertyOf gist:isAbout ;
    rdfs:domain inv:SourceRecord ;
    rdfs:range inv:Party ;
    skos:prefLabel "record of"@en ;
    skos:definition "Links a source record to the party it was captured about: a person, or an organization."@en .

inv:recordedActor a owl:ObjectProperty ;
    rdfs:domain inv:AuditEntry ;
    rdfs:range inv:Member ;
    skos:prefLabel "recorded actor"@en ;
    skos:definition "Links an audit entry to the member it names as having made the change."@en .

gist:isAbout a owl:ObjectProperty .

gist:isCategorizedBy a owl:ObjectProperty .

inv:action a owl:DatatypeProperty ;
    rdfs:domain inv:AuditEntry ;
    rdfs:range xsd:string ;
    skos:prefLabel "action"@en ;
    skos:definition "What was done in the change an audit entry records, in a few words a person reads."@en .

inv:capturedAt a owl:DatatypeProperty ;
    rdfs:domain inv:SourceRecord ;
    rdfs:range xsd:dateTime ;
    skos:prefLabel "captured at"@en ;
    skos:definition "The instant a source record was last read from its system: one value, which each later read of the same record replaces."@en .

inv:isCustomer a owl:DatatypeProperty ;
    rdfs:domain inv:SourceRecord ;
    rdfs:range xsd:boolean ;
    skos:prefLabel "is customer"@en ;
    skos:altLabel "Buyer"@en ,
        "Client"@en ,
        "Customer"@en ;
    skos:definition "Whether the tenant's record of a trading account, one whose source has a trading-role field such as a Sutton company's, states that the party buys from the tenant: true or false on every such stored record, and stated on no other record."@en .

inv:isVendor a owl:DatatypeProperty ;
    rdfs:domain inv:SourceRecord ;
    rdfs:range xsd:boolean ;
    skos:prefLabel "is vendor"@en ;
    skos:altLabel "Supplier"@en ,
        "Vendor"@en ;
    skos:definition "Whether the tenant's record of a trading account, one whose source has a trading-role field such as a Sutton company's, states that the party sells to the tenant: true or false on every such stored record, and stated on no other record."@en .

inv:recordedAt a owl:DatatypeProperty ;
    rdfs:domain inv:AuditEntry ;
    rdfs:range xsd:dateTime ;
    skos:prefLabel "recorded at"@en ;
    skos:definition "The instant at which an audit entry was written."@en .

inv:sourceId a owl:DatatypeProperty ;
    rdfs:domain inv:SourceRecord ;
    rdfs:range xsd:string ;
    skos:prefLabel "source id"@en ;
    skos:definition "The opaque id the external system gives a source record, kept exactly as written."@en .

inv:sourceSystem a owl:DatatypeProperty ;
    rdfs:domain inv:SourceRecord ;
    rdfs:range xsd:string ;
    skos:prefLabel "source system"@en ;
    skos:definition "The external system a source record was read from, as written."@en .

inv:sourceType a owl:DatatypeProperty ;
    rdfs:domain inv:SourceRecord ;
    rdfs:range xsd:string ;
    skos:prefLabel "source type"@en ;
    skos:definition "The record type the external system gives a source record, as written."@en .

inv:GrantScopeKindScheme-organization a owl:NamedIndividual .

inv:MemberRoleScheme-admin a owl:NamedIndividual ,
        inv:Role .

inv:MemberRoleScheme-editor a owl:NamedIndividual ,
        inv:Role .

inv:MemberRoleScheme-viewer a owl:NamedIndividual ,
        inv:Role .
