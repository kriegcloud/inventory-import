{
  "name": "@inventory/client",
  "version": "0.0.0",
  "private": true,
  "description": "The browser's seam to the API with no contract in it: calls bound to a client, optimistic writes with their rollback, a sentence for any failure, and the early requests a page starts before its code has loaded",
  "license": "MIT",
  "type": "module",
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    "./ApiRuntime": "./src/ApiRuntime.runtime.ts",
    "./Http": "./src/Http.runtime.ts",
    "./Early": "./src/Early.runtime.ts",
    "./SayError": "./src/SayError.controller.ts",
    "./Api": "./src/Api.atoms.ts",
    "./OptimisticAtoms": "./src/Optimistic.atoms.ts",
    "./MemberAtoms": "./src/Member.atoms.ts",
    "./ConnectionAtoms": "./src/Connection.atoms.ts",
    "./TabAtoms": "./src/Tab.atoms.ts",
    "./Storage": "./src/Storage.browser.ts"
  },
  "scripts": {
    "check": "tsrs -p tsconfig.json && tsrs -p tsconfig.test.json && beep-cli quality strict strict-ceiling.json",
    "lint": "oxlint --quiet src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/atom-react": "catalog:",
    "@inventory/kernel": "workspace:*",
    "effect": "catalog:",
    "sonner": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:"
  },
  "beep": {
    "family": "web-kit"
  }
}
