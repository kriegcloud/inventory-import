{
  "name": "@inventory/ontology",
  "version": "0.0.0",
  "private": true,
  "description": "The ontology of the inventory app's vocabulary: the gates that hold the kernel's terms coherent, and later the projection of the terms and records into generated RDF. Run, never imported",
  "license": "MIT",
  "type": "module",
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "tsrs -p tsconfig.test.json && tsrs -p tsconfig.json",
    "lint": "oxlint --quiet src test scripts",
    "reason": "bun scripts/reason.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@beep/identity": "workspace:*",
    "@beep/schema": "workspace:*",
    "@beep/vocabulary": "workspace:*",
    "@inventory/access-contract": "workspace:*",
    "@inventory/kernel": "workspace:*",
    "effect": "catalog:",
    "n3": "^2.13.12"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/n3": "^1.26.6",
    "@types/node": "catalog:",
    "oxigraph": "^0.5.13",
    "vitest": "catalog:"
  },
  "beep": {
    "family": "ontology"
  }
}
