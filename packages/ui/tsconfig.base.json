{
  // The design system's profile: the repository profile (../../tsconfig.base.json, beep-effect's) with the two recorded
  // exceptions the app's web code has (decision "ui-packages brief", (d)).
  // `plugins` replaces the inherited plugin list as a whole, so the block below repeats the root's options;
  // the check (../../bun run beep quality strict) fails when it differs from the root's anywhere but `overrides`.
  //
  // `paths` lets the shadcn CLI resolve components.json's aliases when it adds a component here.
  // Stage C, own code (src outside components and hooks): beep-effect's profile has no per-file overrides; this one is
  // deliberate. Four style rules are off here: preferEffectArray, preferEffectString, preferEffectRecord and
  // missingPipeableSignature. Every other rule is at its root severity. Their findings are still counted by
  // `bun run check:strict`, against the ceiling in strict-ceiling.json, which may only fall; remove the override
  // when the count reaches zero.
  //
  // Stage D, the vendored components and hooks (src/components, src/hooks): every rule off, a permanent exception. They are shadcn,
  // Dice UI and tablecn components as published plus local edits; regenerating them would undo the edits and rewriting
  // them buys nothing.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "@effect/language-service",
        "namespaceImportPackages": ["effect", "@effect/*", "@beep/*"],
        "ignoreEffectSuggestionsInTscExitCode": false,
        "ignoreEffectWarningsInTscExitCode": false,
        "ignoreEffectErrorsInTscExitCode": false,
        "includeSuggestionsInTsc": true,
        "skipDisabledOptimization": false,
        "effectFn": ["span", "inferred-span", "suggested-span"],
        "importAliases": {
          "Array": "A",
          "Option": "O",
          "Predicate": "P",
          "Record": "R",
          "Schema": "S",
          "Equal": "Eq"
        },
        "refactors": true,
        "diagnostics": true,
        "quickinfo": true,
        "completions": true,
        "goto": true,
        "renames": true,
        "allowedExperimentalApis": [],
        "allowedUnstableApis": [],
        "inlays": false,
        "mermaidProvider": "mermaid.live",
        "noExternal": false,
        "layerGraphFollowDepth": 0,
        "barrelImportPackages": [],
        "topLevelNamedReexports": "ignore",
        "keyPatterns": [
          {
            "target": "service",
            "pattern": "default",
            "skipLeadingPath": ["src/"]
          },
          {
            "target": "custom",
            "pattern": "default",
            "skipLeadingPath": ["src/"]
          }
        ],
        "extendedKeyDetection": false,
        "brandedSchemaClasses": ["Class", "TaggedClass", "Error", "TaggedError", "Opaque"],
        "pipeableMinArgCount": 2,
        "allowedDuplicatedPackages": [],
        "overrides": [
          {
            "include": ["src/**/*.ts", "src/**/*.tsx"],
            "options": {
              "diagnosticSeverity": {
                "preferEffectArray": "off",
                "preferEffectString": "off",
                "preferEffectRecord": "off",
                "missingPipeableSignature": "off"
              }
            }
          },
          {
            "include": ["src/components/**/*.ts", "src/components/**/*.tsx", "src/hooks/**/*.ts", "src/hooks/**/*.tsx"],
            "options": {
              "diagnosticSeverity": {
                "abortControllerInEffect": "off",
                "acquireReleaseDisposable": "off",
                "allOfMapToForEach": "off",
                "anyUnknownInErrorContext": "off",
                "apiStabilityLeak": "off",
                "asyncFunction": "off",
                "catchAllTagDispatchToCatchTag": "off",
                "catchAllToMapError": "off",
                "catchChainToFirstSuccessOf": "off",
                "catchConditionalRefailToCatchIf": "off",
                "catchDieToOrDie": "off",
                "catchIfTagToCatchTag": "off",
                "catchRefailToTapError": "off",
                "catchTagToCatchReason": "off",
                "catchToIgnore": "off",
                "catchToOrElseSucceed": "off",
                "catchUnfailableEffect": "off",
                "classSelfMismatch": "off",
                "cryptoRandomUUID": "off",
                "cryptoRandomUUIDInEffect": "off",
                "deterministicKeys": "off",
                "duplicatePackage": "off",
                "effectDoNotation": "off",
                "effectFnIife": "off",
                "effectFnImplicitAny": "off",
                "effectFnOpportunity": "off",
                "effectGenUsesAdapter": "off",
                "effectInFailure": "off",
                "effectInVoidSuccess": "off",
                "effectMapFlatten": "off",
                "effectMapVoid": "off",
                "effectSleepZeroToYieldNow": "off",
                "effectSucceedWithUndefined": "off",
                "effectSucceedWithVoid": "off",
                "effectTryWithoutCatch": "off",
                "errorPayloadShadowsName": "off",
                "experimentalApiUsage": "off",
                "extendsNativeError": "off",
                "failCauseToConstructor": "off",
                "flatMapConditionalToFilterOrFail": "off",
                "flatMapIdentityToFlatten": "off",
                "flatMapIgnoredParamToAndThen": "off",
                "flatMapMapToZipWith": "off",
                "flatMapProvideServiceToProvideServiceEffect": "off",
                "flatMapToMap": "off",
                "flatMapToTap": "off",
                "floatingEffect": "off",
                "floatingEffectInVitest": "off",
                "forLoopPushToForEach": "off",
                "genericEffectServices": "off",
                "globalConsole": "off",
                "globalConsoleInEffect": "off",
                "globalDate": "off",
                "globalDateInEffect": "off",
                "globalErrorInEffectCatch": "off",
                "globalErrorInEffectFailure": "off",
                "globalFetch": "off",
                "globalFetchInEffect": "off",
                "globalJson": "off",
                "globalJsonInEffect": "off",
                "globalRandom": "off",
                "globalRandomInEffect": "off",
                "globalTimers": "off",
                "globalTimersInEffect": "off",
                "instanceOfSchema": "off",
                "layerMergeAllWithDependencies": "off",
