+  for (const property of ast.propertySignatures) {
+    const key = String(property.name);
+    const held = fields[key];
+    const given = property.type.context?.constructorDefault;
+    if (held !== undefined && held._tag !== "Undef") {
+      const inner = withDefaults(held, property.type);
+      if ("unread" in inner) return inner;
+      fields[key] = inner.made;
+      continue;
+    }
+    if (given === undefined) continue;
+    if (held !== undefined || !Exit.isExit(given) || !Exit.isSuccess(given)) return { unread: key };
