{
  "$schema": "./node_modules/turbo/schema.json",
  "futureFlags": { "globalConfiguration": true },
  "global": {
    // Every task's hash starts from these. A package's own package.json is already in its inputs.
    // The files bun applies to dependencies at an install are among them (docs/patches.md): bun.lock holds a patch's
    // path and never its content, so without them a changed patch would replay a result made with the old one, a
    // proof of the review's model included.
    // And the one Node that runs every task (`.tool-versions`: the workflows set it up from this file, and a version
    // manager runs it on a workstation), so a result made under one Node is never replayed under another.
    "inputs": [".bun-version", ".tool-versions", "bunfig.toml", "packages/patches/*.patch"],
    // A task sees only the variables named for it: its own `env`, which are in its hash, and the ones below, which
    // are not, beside the few turbo always lets through (PATH, HOME, the terminal's). So a variable set in a shell
    // and named nowhere (a key, `AI_ENABLED`) reaches no task and changes no result, on the workstation or on CI:
    // a result stored on one may be replayed on the other (goals/ci-speed).
    "envMode": "strict",
    // Let through and not hashed, because none of them changes whether a task passes:
    // - `CI` and `GITHUB_ACTIONS`: Vitest refuses to write a new snapshot under CI, and a retried test is reported as
    //   an annotation on GitHub's runner (vitest.retries.ts). The one task whose answer depends on `CI` is the
    //   model's `verify`, which names it in its own `env`.
    // - `VITEST_MAX_WORKERS`: how many workers a test run may start; CI gives one (docs/standards/engineering.md).
    // - `LEDGER_BASE`: the commit CI names for the laws with a ledger, which are never replayed.
    // - `JAVA_HOME` and `XDG_CACHE_HOME`: where the reasoner finds Java and keeps its jar; `reason` is never replayed.
    // - `MISE_*`: the version manager's own, so its shims find the Node `.tool-versions` pins.
    "passThroughEnv": [
      "CI",
      "GITHUB_ACTIONS",
      "VITEST_MAX_WORKERS",
      "LEDGER_BASE",
      "JAVA_HOME",
      "XDG_CACHE_HOME",
      "MISE_*"
    ]
  },
  "tasks": {
    // A task with no script anywhere: depending on `^transit` folds every workspace dependency's source into a
    // task's hash, so a cached check cannot survive a change in a package it imports. Packages export TypeScript
    // source and never build, so `check` has no `^build` edge to do this.
    // It also waits for what is installed to hold every patch (`//#patches:installed`, below), and so does every
    // task that depends on it: the type-check, the tests, the fold, the slow tests and the build.
    "transit": {
      "dependsOn": ["^transit", "//#patches:installed"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!test/**"]
    },
    // Type-check with the Effect diagnostics.
    // A package's check may run the repository's own commands (quality strict, laws exports). Their source, and the
    // kit it is built on, reach the hash through the CLI's own `transit`, and nothing else does it: the root has no
    // dependency on the CLI, which would put its source into every task's hash, a proof's included (goals/ci-speed).
    "check": {
      "dependsOn": ["transit", "@beep/repo-cli#transit"],
      "outputs": []
    },
    // oxlint, and the design-system lint in packages with screens. A package's own lint profile is in its files; the
    // root profiles they extend (the atoms rule, the design lints) are inputs too, so a change to one is not replayed.
    "lint": {
      "dependsOn": ["//#patches:installed"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc*.json"],
      "outputs": []
    },
    // The fast tests. Their limits and retries are the root's (vitest.shared.ts, vitest.retries.ts), which every
    // package's vitest.config.ts imports. `PROPERTY_RUNS` gives the longest properties fewer runs on a pull request
    // (vitest.shared.ts), so it is in the hash: a result made at one count is never replayed at the other.
    "test": {
      "dependsOn": ["transit"],
      "env": ["PROPERTY_RUNS"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.shared.ts", "$TURBO_ROOT$/vitest.retries.ts"],
      "outputs": []
    },
    // The proofs of a model's rules (`*.prove.test.ts`, the "prove" project of a package's Vitest): minutes on a busy
    // machine, and part of `bun run check`. No `transit` edge: a proof reads the model's own files and the library, so
    // a package that has proofs names exactly those in its own turbo.json, and a proof is replayed until one changes.
    "prove": { "dependsOn": ["//#patches:installed"], "outputs": [] },
    // The search of a whole model under Verify (`*.verify.test.ts`, the "verify" project): every proof again, then
    // every short sequence of commands and the longer walks. Longer than the proofs, so only `bun run check:full`
    // runs it. Like `prove` it has no `transit` edge and names its own inputs, and is replayed until one changes.
    "verify": { "dependsOn": ["//#patches:installed"], "outputs": [] },
    // The mutants of a model: each one change to its code, which its proofs or its stories must notice. A package that
    // has them names their inputs in its own turbo.json. The sample is in `bun run check:full`; all of them run in
    // the nightly workflow.
    "mutants:sample": { "dependsOn": ["//#patches:installed"], "outputs": [] },
    "mutants": { "dependsOn": ["//#patches:installed"], "outputs": [] },
    // A long property beside a package's fast tests (`*.fold.test.ts`, the "fold" project): the review's model held
    // against the review region, over a minute. Like the fast tests it reads its package and what it depends on, so
    // it is replayed until one of them changes; it is in `bun run check:full`, not in `bun run check`.
    "fold": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.shared.ts", "$TURBO_ROOT$/vitest.retries.ts"],
      "outputs": []
    },
    // The slow tests: workerd, a real D1 database and sign-in. Everything they read is in their package or one it
    // imports, so like the fast tests they are replayed until one of those changes.
    "test:slow": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.shared.ts", "$TURBO_ROOT$/vitest.retries.ts"],
      "outputs": []
    },
    // A test that calls a real service on the network (`*.live.test.ts`: the breach check against Have I Been
    // Pwned). The service's answer is in no file, so a result is never replayed.
    "test:live": { "dependsOn": ["transit"], "cache": false },
    // The production build and its identity check. Cloudflare's Vite plugin copies a `.dev.vars` (and a `.env`) it
    // finds beside the app into `dist`, for `vite preview`; that file holds the workstation's secrets, so it is
    // never part of the result turbo stores and may share. `test/TurboCache.test.ts` of the CLI holds these lines.
    // What the build reads from the environment is in its hash: which of wrangler's environments it builds for, the
    // bundle report's switch, and the mark Alchemy sets when it runs the build itself.
    "build": {
      "dependsOn": ["transit"],
      "env": ["CLOUDFLARE_ENV", "BUNDLE_REPORT", "ALCHEMY_CLOUDFLARE_VITE_INJECTED"],
      "outputs": ["dist/**", "!dist/**/.dev.vars", "!dist/**/.dev.vars.*", "!dist/**/.env", "!dist/**/.env.*"]
    },
    "dev": { "dependsOn": ["//#patches:installed"], "cache": false, "persistent": true },
    // Repository checks: root scripts that do not call turbo.
    // Every file but the scratchpad's: the formatter leaves it alone (.oxfmtrc.json), and an experiment that is not
    // formatted, or does not parse, fails nothing here.
    "//#format:check": { "inputs": ["$TURBO_DEFAULT$", "!scratchpad/**"], "outputs": [] },
    // Vendored kit packages still match the beep-effect files they were copied from (`beep vendor check`).
    "//#vendor:check": {
      "inputs": [
        "packages/**/vendor.json",
        "packages/**/package.json",
        "packages/**/src/**",
        "packages/**/test/**",
        "packages/tooling/tool/cli/src/**"
      ],
      "outputs": []
    },
    // The Alchemy packages kept as files are the ones `vendor/alchemy/sources.json` names, hash for hash, and the
    // overrides, the README's table and the lockfile agree with it (`vendor/alchemy/repin.py --check`; needs
    // python3). A third of a second, so it runs every time and names no inputs.
    "//#alchemy:check": { "cache": false },
    // The stage C ceilings of the packages with screens add up to at most 678 (`beep quality ceilings`).
    "//#ceilings:check": {
      // The CLI's source is named below; the kit it imports comes with its `transit`, as for a package's `check`.
      "dependsOn": ["@beep/repo-cli#transit"],
      "inputs": ["apps/*/strict-ceiling.json", "packages/**/strict-ceiling.json", "packages/tooling/tool/cli/src/**"],
      "outputs": []
    },
    // Which package may import which (`beep laws boundaries`): every package.json and every import under src and test.
    "//#boundaries:check": {
      // What the law reads: every manifest, every file under src and test, and for the scratchpad's rule also each
      // workspace's scripts, its root files and stylesheets, and the repository's own root files and manifest.
      "inputs": [
        "package.json",
        "*.{ts,tsx,mts,cts,js,mjs,cjs}",
        "apps/**/package.json",
        "apps/**/*.{ts,tsx,mts,cts,js,mjs,cjs,css}",
        "packages/**/package.json",
        "packages/**/*.{ts,tsx,mts,cts,js,mjs,cjs,css}",
        "scratchpad/package.json",
        "packages/tooling/tool/cli/src/**",
        "!**/node_modules/**",
        "!**/dist/**",
        "!**/.wrangler/**"
      ],
      "outputs": []
    },
    // Every package with screens is in both lists Tailwind reads class names from (`beep laws screens`).
    "//#screens:check": {
      "dependsOn": ["@beep/repo-cli#transit"],
      "inputs": [
        "apps/inventory/package.json",
        "apps/inventory/src/web/index.css",
        "apps/inventory/vite.config.ts",
        "packages/**/package.json",
        "packages/**/src/**/*.tsx",
        "packages/tooling/tool/cli/src/**"
      ],
      "outputs": []
    },
    // Every ref is a DOM ref or a callback that stays the same across draws (`beep laws ref-callbacks`).
    // Its inputs are the law's own pathspec: every .tsx git would commit, the vendored kit, the skills and the
    // scratchpad left out; and
    // every package.json, whose exports name the modules of hooks.
    "//#refs:check": {
      "dependsOn": ["@beep/repo-cli#transit"],
      "inputs": [
        "**/*.tsx",
        "!**/node_modules/**",
        "!packages/ui/src/components/**",
        "!packages/ui/src/hooks/**",
        "!.agents/**",
        "!scratchpad/**",
        "apps/**/package.json",
        "packages/**/package.json",
        "packages/tooling/tool/cli/src/**"
      ],
      "outputs": []
    },
    // Absence, starting values and clean-ups are a schema's (`beep laws defaults`): no file holds more fallbacks,
    // comparisons with null or undefined, Options turned back into missing values, or clean-ups outside a schema than
    // `defaults-baseline.json` allows it. The baseline only falls.
    "//#defaults:check": {
      // Its baseline is compared with main's, and main is no file turbo can hash: never replayed from the cache.
      "cache": false,
      "inputs": [
        "apps/*/src/**/*.{ts,tsx}",
        "apps/*/test/**/*.{ts,tsx}",
        "packages/**/src/**/*.{ts,tsx}",
        "packages/**/test/**/*.{ts,tsx}",
        "packages/client/**/*.{ts,tsx}",
        "packages/review/**/*.{ts,tsx}",
        "packages/ui/**/*.{ts,tsx}",
        "packages/**/vendor.json",
        "defaults-baseline.json",
        "packages/tooling/tool/cli/src/**"
      ],
      "outputs": []
    },
    // No `_tag` is told apart or built by hand in our own code and every test (`beep laws tags`), with no file
    // excepted: a count per file would let one hand-written tag be swapped for another.
    "//#tags:check": {
      "inputs": [
        "apps/*/src/**/*.{ts,tsx}",
        "apps/*/test/**/*.{ts,tsx}",
        "packages/**/src/**/*.{ts,tsx}",
        "packages/**/test/**/*.{ts,tsx}",
        "packages/client/**/*.{ts,tsx}",
        "packages/review/**/*.{ts,tsx}",
        "packages/ui/**/*.{ts,tsx}",
        "packages/**/vendor.json",
        "packages/tooling/tool/cli/src/**"
      ],
      "outputs": []
    },
    // Every Effect import from its own path under its own name (`beep laws effect-imports`,
    // docs/standards/effect-imports.md): code, the examples in its comments, and the standing documents.
    "//#imports:check": {
      "inputs": [
        "apps/**/*.{ts,tsx,mts,mjs}",
        "packages/**/*.{ts,tsx,mts,mjs}",
        "packages/**/vendor.json",
        "*.md",
        "docs/**/*.md",
        ".claude/agents/*.md",
        "bun.lock"
      ],
      "outputs": []
    },
    // Every version and date written in more than one place equals its one source (`beep version-sync`): the
    // package.json files, the workflows, the standing documents, the wrangler files, the stacks and the CLI's own
    // source. The installed @effect/tsgo it compares a `$schema` with is hashed through bun.lock.
    "//#version-sync": {
      "inputs": [
        "packages/foundation/modeling/identity/src/**",
        "packages/foundation/modeling/schema/src/**",
        "packages/foundation/modeling/utils/src/**",
        "package.json",
        "apps/**/package.json",
        "packages/**/package.json",
        ".github/workflows/**",
        "CLAUDE.md",
        "AGENTS.md",
        "README.md",
        "docs/**/*.md",
        ".claude/agents/*.md",
        "tsconfig*.json",
        "apps/**/tsconfig*.json",
        "packages/**/tsconfig*.json",
        "apps/**/wrangler*.jsonc",
        "packages/**/wrangler*.jsonc",
        "packages/**/src/**/*.ts",
        "vendor/alchemy/sources.json",
        "bun.lock",
        "!**/node_modules/**"
      ],
      "outputs": []
    },
    // The lists and paths that follow from the workspaces are what the workspaces say (`beep config-sync --check`):
    // every configuration file of the root and of each package, each package's scripts, and what a package holds
    // (a vitest.config.ts, a vendor.json, a ceiling file). An installed file a `$schema` names is hashed through
    // bun.lock.
    "//#config-sync:check": {
      "dependsOn": ["@beep/repo-cli#transit"],
      "inputs": [
        "packages/foundation/modeling/identity/src/**",
        "packages/foundation/modeling/schema/src/**",
        "packages/foundation/modeling/utils/src/**",
        "*.{json,jsonc}",
        ".oxlintrc*.json",
        ".oxfmtrc.json",
        ".syncpackrc.json",
        "apps/**/*.{json,jsonc}",
        "apps/**/.oxlintrc*.json",
        "apps/**/vitest.config.ts",
        "packages/**/*.{json,jsonc}",
        "packages/**/.oxlintrc*.json",
        "packages/**/vitest.config.ts",
        "packages/tooling/tool/cli/src/**",
        "bun.lock",
        "!**/node_modules/**",
        "!**/dist/**",
        "!**/.wrangler/**",
        "!**/.turbo/**"
      ],
      "outputs": []
    },
    // No deprecated API is used (`beep laws deprecated-apis`), read from every file's types: a new `@deprecated` in one
    // file, in a tsconfig's reach or in an installed package changes the answer for a file that did not change. So every
    // code file and tsconfig is an input, in a folder nobody listed too, with every workspace's manifest and what is
    // installed: the lockfile, and the manifest of every installed package in the root's node_modules, nested ones
    // included, so an install that has fallen behind the lockfile is not answered from one that had not. Turbo applies
    // every `!` to every line above it, so node_modules is not excluded whole: only its code files and tsconfigs are.
    // Left out by name: what git ignores and the law does not read (`.agents`, the scratchpad, and `.claude`, which
    // in the main checkout holds every other checkout of this repository).
    "//#deprecated:check": {
      "dependsOn": ["//#patches:installed"],
      "inputs": [
        ".oxlintrc.deprecated-apis.json",
        ".gitignore",
        "**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
        "**/tsconfig*.json",
        "package.json",
        "apps/**/package.json",
        "packages/**/package.json",
        "!node_modules/**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
        "!node_modules/**/tsconfig*.json",
        "!apps/**/{node_modules,dist,.wrangler,.turbo}/**",
        "!packages/**/{node_modules,dist,.turbo}/**",
        "!{.claude,.codex,.agents,.turbo,.scratch,.wrangler,.alchemy,.taste-skill,.session,scratchpad}/**",
        "bun.lock",
        "node_modules/*/package.json",
        "node_modules/@*/*/package.json"
      ],
      "outputs": []
    },
    // The vocabulary's marks and its one value are used as report 14 section 6.7 says (`beep laws ontology-terms`,
    // gate 7): every code file git would commit is an input, with what says where an import leads (every
    // `package.json` and tsconfig), the enrolment list, `.gitignore`, `bun.lock` (the parser's version) and the law's
    // own source. Left out as for `try:check`: what the law does not read, and what is installed or built.
    "//#ontology-terms:check": {
      "inputs": [
        ".gitignore",
        "bun.lock",
        "**/*.{ts,tsx,mjs}",
        "**/package.json",
        "**/*.json",
        "!**/node_modules/**",
        "!apps/**/{dist,.wrangler,.turbo}/**",
        "!packages/**/{dist,.turbo}/**",
        "!.claude/worktrees/**",
        "!{.agents,.turbo,.scratch,.wrangler,.alchemy,.taste-skill,.session,scratchpad}/**",
        "packages/tooling/tool/cli/src/**"
      ],
      "outputs": []
    },
    // No `try` statement is written (`beep laws try`), in the code or in a doc comment's example, read from each file's
    // own syntax tree: every code file git would commit is an input, in a folder nobody listed too (`.claude` and
    // `.codex` among them), with `.gitignore`, `bun.lock` (the parser's version) and the law's own source. Left out
    // by name: what the law does not read (`.agents`, the scratchpad and theme-init.js), what is installed or built,
    // and `.claude/worktrees`, which git ignores and which in the main checkout holds every other checkout.
    "//#try:check": {
      "inputs": [
        ".gitignore",
        "bun.lock",
        "**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
        "!**/node_modules/**",
        "!apps/**/{dist,.wrangler,.turbo}/**",
        "!packages/**/{dist,.turbo}/**",
        "!.claude/worktrees/**",
        "!{.agents,.turbo,.scratch,.wrangler,.alchemy,.taste-skill,.session,scratchpad}/**",
        "!apps/inventory/public/theme-init.js",
        "packages/tooling/tool/cli/src/**"
      ],
      "outputs": []
    },
    // No Promise is written (`beep laws promises`), but in the files its lists name: every code file git would commit
    // is an input, as for the try law, with the law's own source, and what its typed half reads besides: its profile,
    // every tsconfig and every package.json, so a cached answer is never replayed over a changed one.
    "//#promises:check": {
      // Its ledger is compared with main's, and main is no file turbo can hash: never replayed from the cache.
      "cache": false,
      "inputs": [
        ".oxlintrc.promises.json",
        "**/tsconfig*.json",
        "**/package.json",
        "!**/node_modules/**",
        ".gitignore",
        "bun.lock",
        "**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
        "!**/node_modules/**",
        "!apps/**/{dist,.wrangler,.turbo}/**",
        "!packages/**/{dist,.turbo}/**",
        "!.claude/worktrees/**",
        "!{.agents,.turbo,.scratch,.wrangler,.alchemy,.taste-skill,.session,scratchpad}/**",
        "packages/tooling/tool/cli/src/**"
      ],
      "outputs": []
    },
    // No `@effect-diagnostics` directive turns a rule off (`beep laws diagnostics`), but in the files it lists.
    "//#diagnostics:check": {
      // Its ledger is compared with main's, and main is no file turbo can hash: never replayed from the cache.
      "cache": false,
      "inputs": [
        ".gitignore",
        "bun.lock",
        "**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
        "!**/node_modules/**",
        "!apps/**/{dist,.wrangler,.turbo}/**",
        "!packages/**/{dist,.turbo}/**",
        "!.claude/worktrees/**",
        "!{.agents,.turbo,.scratch,.wrangler,.alchemy,.taste-skill,.session,scratchpad}/**",
        "packages/tooling/tool/cli/src/**"
      ],
      "outputs": []
    },
    // Every helper declared with two values or more takes the one it acts on first and is dual (`beep laws dual`).
    "//#dual:check": {
      // Its ledger is compared with main's, and main is no file turbo can hash: never replayed from the cache.
      "cache": false,
      "inputs": [
        ".gitignore",
        "bun.lock",
        "**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
        "!**/node_modules/**",
        "!apps/**/{dist,.wrangler,.turbo}/**",
        "!packages/**/{dist,.turbo}/**",
        "!.claude/worktrees/**",
        "!{.agents,.turbo,.scratch,.wrangler,.alchemy,.taste-skill,.session,scratchpad}/**",
        "packages/tooling/tool/cli/src/**"
      ],
      "outputs": []
    },
    // Every property of an object type or an interface is readonly (`beep laws readonly`).
    "//#readonly:check": {
      // Its ledger is compared with main's, and main is no file turbo can hash: never replayed from the cache.
      "cache": false,
      "inputs": [
        ".gitignore",
        "bun.lock",
        "**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
        "!**/node_modules/**",
        "!apps/**/{dist,.wrangler,.turbo}/**",
        "!packages/**/{dist,.turbo}/**",
        "!.claude/worktrees/**",
        "!{.agents,.turbo,.scratch,.wrangler,.alchemy,.taste-skill,.session,scratchpad}/**",
        "packages/tooling/tool/cli/src/**"
      ],
      "outputs": []
    },
    // Every file of screens exports components only (`beep laws fast-refresh`, `.oxlintrc.fast-refresh.json`).
    "//#fast-refresh:check": {
      // Its ledger is compared with main's, and main is no file turbo can hash: never replayed from the cache.
      "cache": false
    },
    // No type assertion is written (oxlint, `.oxlintrc.assertions.json`, from the root), and its lists only shrink
    // (`beep laws assertions`).
    "//#assertions:check": {
      // Its ledger is compared with main's, and main is no file turbo can hash: never replayed from the cache.
      "cache": false,
      "inputs": [
        ".oxlintrc.assertions.json",
        ".gitignore",
        "bun.lock",
        "**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
        "!**/node_modules/**",
        "!apps/**/{dist,.wrangler,.turbo}/**",
        "!packages/**/{dist,.turbo}/**",
        "!.claude/worktrees/**",
        "!{.agents,.turbo,.scratch,.wrangler,.alchemy,.taste-skill,.session,scratchpad}/**",
        "packages/tooling/tool/cli/src/**"
      ],
      "outputs": []
    },
    // The root's own .ts files and each package's vitest.config.ts type-check (tsconfig.config.json). Only the linter
    // above reads that project otherwise, and an import that does not resolve there would hide a deprecated call.
    "//#configs:check": {
      "dependsOn": ["//#patches:installed"],
      "inputs": [
        "tsconfig.config.json",
        "tsconfig.base.json",
        "*.ts",
        "packages/**/*.{ts,tsx}",
        "packages/**/package.json",
        "!packages/**/{node_modules,dist}/**",
        "package.json",
        "bun.lock"
      ],
      "outputs": []
    },
    // Its tests run that law with the root's own profile and the installed packages, whose deprecation notes they
    // expect word for word: the same installed manifests are inputs here. One of its tests reads the workflows GitHub
    // runs (test/DeployWorkflow.test.ts), so a change to a workflow alone runs the tests again and is never replayed.
    // Another reads every turbo.json (test/TurboCache.test.ts), and the Node pinned in `.tool-versions`, a global input.
    "@beep/repo-cli#test": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.github/workflows/**",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/apps/*/turbo.json",
        "$TURBO_ROOT$/packages/**/turbo.json",
        "$TURBO_ROOT$/vitest.shared.ts",
        "$TURBO_ROOT$/vitest.retries.ts",
        "$TURBO_ROOT$/.oxlintrc.deprecated-apis.json",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/node_modules/*/package.json",
        "$TURBO_ROOT$/node_modules/@*/*/package.json"
      ],
      "outputs": []
    },
    // bun.lock says what every package.json asks for, so CI's `bun install --frozen-lockfile` accepts it. Resolved
    // from bun's cache, never the network, and nothing is written or installed: a package.json that asks for a
    // version bun.lock does not hold fails here, before a push.
    "//#lockfile:check": {
      "inputs": [
        "package.json",
        "apps/**/package.json",
        "packages/**/package.json",
        "bun.lock",
        "bunfig.toml",
        "!**/node_modules/**"
      ],
      "outputs": []
    },
    // Every patch to a dependency has its header and its test, is for what bun.lock holds, applies to the kept file
    // it names, and is what is installed (`beep patches check`, docs/patches.md). The last is read from
    // node_modules, which no input can stand for: bun leaves a patch out with one warning line and exit 0. So this
    // runs every time; it takes about a second.
    "//#patches:check": { "cache": false },
    // What is in node_modules holds what every registered patch writes (`beep patches installed`). The patch files
    // are in every task's hash and node_modules is in none, so a task run after a patch changed and before
    // `bun install` would run on the package as it was and be stored under the new patch's hash, then replayed
    // after the install. So every task that runs or type-checks code waits for this one, whichever script started
    // it (`bun run test` and `bun run proofs` too), and a failure here runs none of them: every package task above
    // (`beep patches check` refuses one that does not), and the two root tasks that read installed types. Never
    // replayed; under a second. A waiting task takes this one's hash into its own: the files bun applies, which
    // every task has already, and the root's package.json, which says which file bun applies to which package
    // (turbo adds a package's own package.json to each of its tasks). So an edit to the root's package.json runs
    // every task again: without it, a line taken out of `patchedDependencies` would replay results made with the
    // patch.
    "//#patches:installed": { "cache": false, "inputs": ["packages/patches/*.patch"] },
    // Each patch's test fails beside the package with that one patch left out and the others applied (`beep patches
    // prove`): the patches and their tests, the kept files they are applied to, and what the tests are run with.
    "//#patches:prove": {
      "dependsOn": ["@beep/repo-cli#transit"],
      "inputs": [
        "packages/patches/**",
        "!packages/patches/node_modules/**",
        "vendor/alchemy/*.tgz",
        "package.json",
        "bun.lock",
        "packages/tooling/tool/cli/src/**"
      ],
      "outputs": []
    },
    // No home path or private folder is named in the scratchpad (`beep laws private-paths`): every file in it.
    "//#private-paths:check": {
      "dependsOn": ["@beep/repo-cli#transit"],
      "inputs": ["scratchpad/**", "!scratchpad/**/node_modules/**", "packages/tooling/tool/cli/src/**"],
      "outputs": []
    },
    // Every file git would commit, so its hash is the whole repository's, the scratchpad's experiments included: a
    // key in an experiment is refused like any other, and this is the one root task an edit there re-runs.
    "//#keys:check": { "outputs": [] },
    "//#docs:check": {
      "dependsOn": ["@beep/repo-cli#transit"],
      "inputs": [
        "docs/**",
        "explorations/**",
        "goals/**",
        "packages/tooling/tool/cli/src/**",
        ".agents/skills/okf-open-knowledge-format/**"
      ],
      "outputs": []
    }
  }
}
