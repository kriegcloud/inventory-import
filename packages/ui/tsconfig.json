{
  "extends": "./tsconfig.base.json",
  "$schema": "../../node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "jsx": "react-jsx",
    "paths": {
      "@inventory/ui/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
