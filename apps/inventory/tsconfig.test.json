{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "lib": ["ESNext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"]
  },
  // The tests of the browser's code have the browser's types: tsconfig.test-web.json.
  "include": ["test"],
  "exclude": ["test/web"]
}
