    skos:notation "phone" ;
    skos:inScheme inv:ContactPointKindScheme ;
    skos:topConceptOf inv:ContactPointKindScheme .

inv:ContactPurposeScheme-billing a skos:Concept ;
    skos:prefLabel "Billing"@en ;
    skos:altLabel "Bill-to"@en ;
