{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    // Hand-rolling: a native control or table in feature code where a component from src/web/components/ui exists.
    // This config ignores src/web/components/ui, so the components themselves may still render these elements.
    "react/forbid-elements": [
      "error",
      {
        "forbid": [
          {
            "element": "button",
            "message": "Hand-rolled <button>. Use <Button> from @/components/ui/button: its variant and size props, ghost for a quiet action."
          },
          {
            "element": "input",
            "message": "Hand-rolled <input>. Use <Input> from @/components/ui/input; for a type, <Checkbox>, <RadioGroup>, <Switch>, <Slider> or <FileUpload>."
          },
          {
            "element": "select",
            "message": "Hand-rolled <select>. Use <NativeSelect> from @/components/ui/native-select, or <Select> for a styled list."
          },
          {
            "element": "textarea",
            "message": "Hand-rolled <textarea>. Use <Textarea> from @/components/ui/textarea."
          },
          {
            "element": "label",
            "message": "Hand-rolled <label>. Use <Label> from @/components/ui/label, or <Field> and <FieldLabel> from @/components/ui/field in a form."
          },
          {
            "element": "table",
            "message": "Hand-rolled <table>. Use <Table> from @/components/ui/table: it already draws the grid, the 36px header and 13px text."
          },
          {
            "element": "thead",
            "message": "Hand-rolled <thead>. Use <TableHeader> from @/components/ui/table."
          },
          {
            "element": "tbody",
            "message": "Hand-rolled <tbody>. Use <TableBody> from @/components/ui/table."
          },
          {
            "element": "tfoot",
            "message": "Hand-rolled <tfoot>. Use <TableFooter> from @/components/ui/table."
          },
          {
            "element": "tr",
            "message": "Hand-rolled <tr>. Use <TableRow> from @/components/ui/table."
          },
          {
            "element": "th",
            "message": "Hand-rolled <th>. Use <TableHead> from @/components/ui/table, with scope=row for a row's name."
          },
          {
            "element": "td",
            "message": "Hand-rolled <td>. Use <TableCell> from @/components/ui/table."
          },
          {
            "element": "caption",
            "message": "Hand-rolled <caption>. Use <TableCaption> from @/components/ui/table."
          },
          {
            "element": "hr",
            "message": "Hand-rolled <hr>. Use <Separator> from @/components/ui/separator."
          },
          {
            "element": "progress",
            "message": "Hand-rolled <progress>. Use <Progress> from @/components/ui/progress."
          },
          {
            "element": "dialog",
            "message": "Hand-rolled <dialog>. Use <Dialog>, <AlertDialog> or <Sheet> from @/components/ui."
          },
          {
            "element": "details",
            "message": "Hand-rolled <details>. Use <Collapsible> or <Accordion> from @/components/ui."
          },
          {
            "element": "fieldset",
            "message": "Hand-rolled <fieldset>. Use <FieldSet> and <FieldLegend> from @/components/ui/field."
          },
          {
            "element": "kbd",
            "message": "Hand-rolled <kbd>. Use <Kbd> from @/components/ui/kbd."
          }
        ]
      }
    ],
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "overrides": [
    {
      // Effect's collections, never the native ones, in the app and its tests: HashMap and HashSet for a value handed
      // on, MutableHashMap and MutableHashSet for one a function fills. WeakMap and WeakSet stay where an entry must go
      // with its key (Effect has no weak collection). The vendored components in src/web/components/ui are ignored
      // above, as published. See "Effect" in CLAUDE.md.
      "files": ["src/**", "test/**"],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "Map",
            "message": "Use HashMap (a value handed on) or MutableHashMap (one a function fills) from effect."
          },
          {
            "name": "Set",
            "message": "Use HashSet (a value handed on) or MutableHashSet (one a function fills) from effect."
          }
        ]
      }
    }
  ],
  "ignorePatterns": ["src/web/components/ui/**", "dist/**", ".agents/**", ".claude/**", ".codex/**"]
}
