{
  "name": "@inventory/access-contract",
  "version": "0.0.0",
  "private": true,
  "description": "What the browser and the rest of the app may ask about who may do what: the session, the people of an organization and the audit trail's read side",
  "license": "MIT",
  "type": "module",
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    "./Access": "./src/Access.contract.ts",
    "./SessionState": "./src/Session/SessionState.read.ts",
    "./Person": "./src/People/Person.read.ts",
    "./PeoplePayload": "./src/People/People.payload.ts",
    "./PeopleRejection": "./src/People/People.rejection.ts",
    "./AuditTrail": "./src/Activity/AuditTrail.read.ts"
  },
  "scripts": {
    "check": "tsrs -p tsconfig.json && tsrs -p tsconfig.test.json",
    "lint": "oxlint --quiet src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@beep/identity": "workspace:*",
    "@beep/schema": "workspace:*",
    "@inventory/kernel": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "vitest": "catalog:"
  },
  "beep": {
    "family": "context",
    "context": "access",
    "layer": "contract"
  }
}
