{
  // Design-system lint: @shadcn/lint over the React app. Run with `bun run lint:shadcn` (part of `bun run check`).
  // Components in src/web/components/ui own their appearance; feature code and pages own layout only; every colour
  // and size comes from the theme in src/web/index.css. Every rule is an error. No disable comments, no allow-lists,
  // no contracts: a finding is fixed in the code or the theme.
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "plugins": [],
  "categories": {
    "correctness": "off",
    "suspicious": "off",
    "perf": "off",
    "style": "off",
    "pedantic": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "jsPlugins": ["@shadcn/lint"],
  "settings": {
    "shadcn": {
      "ui": "@/components/ui",
      "note": "Fix it in the code or in the theme (src/web/index.css), never with a disable comment or an allow-list."
    }
  },
  "ignorePatterns": ["**/dist/**", "**/node_modules/**"],
  "rules": {
    "shadcn/no-restyle": ["error", { "allow": ["layout"] }],
    "shadcn/no-raw-colors": "error",
    "shadcn/no-arbitrary-values": "error",
    "shadcn/no-inline-styles": "error",
    "shadcn/require-static-classes": "error",
    "shadcn/no-unknown-classes": "error"
  },
  "overrides": [
    {
      // Every string literal in the app is a class site: status maps and lookup tables hide raw colours and
      // arbitrary values that a scan of className alone cannot see.
      "files": ["src/web/**/*.ts", "src/web/**/*.tsx"],
      "rules": {
        "shadcn/no-raw-colors": ["error", { "scanAllStrings": true }],
        "shadcn/no-arbitrary-values": ["error", { "scanAllStrings": true }]
      }
    },
    {
      // Vendored components (shadcn/ui and the community registries) own their appearance: they style themselves and
      // call their own variant factories. Their arbitrary values (shadcn's own `focus-visible:ring-[3px]`,
      // `h-[calc(100%-1px)]`, Radix size variables) and inline styles (virtualised row offsets, floating positions,
      // chart variables) are upstream implementation; rewriting them would fork every file from its registry.
      // Raw colours and unknown classes still fail here: those break the theme or generate no CSS.
      "files": ["src/web/components/ui/**"],
      "rules": {
        "shadcn/no-restyle": "off",
        "shadcn/require-static-classes": "off",
        "shadcn/no-arbitrary-values": "off",
        "shadcn/no-inline-styles": "off"
      }
    }
  ]
}
