# inventory-import ontology 0.2.0

@prefix inv: <https://example.org/inventory-import/ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://example.org/inventory-import/taxonomy> a owl:Ontology ;
    owl:versionIRI <https://example.org/inventory-import/taxonomy/0.2.0> ;
    owl:versionInfo "0.2.0" .

inv:GrantScopeKindScheme a skos:ConceptScheme ;
    skos:prefLabel "Grant scope kind"@en ;
    skos:definition "A controlled vocabulary of the extents a grant of access covers: a whole organization, one location, or one field."@en .

inv:IdentityOutcomeScheme a skos:ConceptScheme ;
    skos:prefLabel "Identity outcome"@en ;
    skos:definition "A controlled vocabulary of what an identity decision finds about two source records a tenant holds that may be one party."@en .

inv:MemberRoleScheme a skos:ConceptScheme ;
    skos:prefLabel "Member role"@en ;
    skos:definition "A controlled vocabulary of the access levels a member holds in an organization, ranked by what each may do."@en .

inv:MembershipStatusScheme a skos:ConceptScheme ;
    skos:prefLabel "Membership status"@en ;
    skos:definition "A controlled vocabulary of the stages a person's membership of a tenant passes through, from invited to revoked."@en .

inv:ModelCallPurposeScheme a skos:ConceptScheme ;
    skos:prefLabel "Model call purpose"@en ;
    skos:definition "A controlled vocabulary of what a call to a language model is made for, each call drawn from the day's allowance."@en .

inv:GrantScopeKindScheme-organization a skos:Concept ;
    skos:prefLabel "Whole organization"@en ;
    skos:altLabel "Tenant"@en ;
    skos:definition "A grant scope kind in which the grant covers every record of one organization."@en ;
    skos:notation "organization" ;
    skos:inScheme inv:GrantScopeKindScheme ;
    skos:topConceptOf inv:GrantScopeKindScheme .

inv:IdentityOutcomeScheme-differentParties a skos:Concept ;
    skos:prefLabel "Different parties"@en ;
    skos:altLabel "Not a duplicate"@en ;
    skos:definition "An identity outcome in which two source records a tenant holds are found to be records of two parties."@en ;
    skos:notation "differentParties" ;
    skos:inScheme inv:IdentityOutcomeScheme ;
    skos:topConceptOf inv:IdentityOutcomeScheme .

inv:IdentityOutcomeScheme-sameParty a skos:Concept ;
    skos:prefLabel "Same party"@en ;
    skos:altLabel "Merge"@en ;
    skos:definition "An identity outcome in which two source records a tenant holds are found to be records of one party."@en ;
    skos:notation "sameParty" ;
    skos:inScheme inv:IdentityOutcomeScheme ;
    skos:topConceptOf inv:IdentityOutcomeScheme .

inv:MemberRoleScheme-admin a skos:Concept ;
    skos:prefLabel "Admin"@en ;
    skos:altLabel "Administrator"@en ;
    skos:definition "A member role whose holder may read and write the organization's records and add, change and remove its people."@en ;
    skos:notation "admin" ;
    skos:inScheme inv:MemberRoleScheme ;
    skos:topConceptOf inv:MemberRoleScheme .

inv:MemberRoleScheme-editor a skos:Concept ;
    skos:prefLabel "Editor"@en ;
    skos:definition "A member role whose holder may read and write the organization's records but not manage its people."@en ;
    skos:notation "editor" ;
    skos:inScheme inv:MemberRoleScheme ;
    skos:topConceptOf inv:MemberRoleScheme .

inv:MemberRoleScheme-viewer a skos:Concept ;
    skos:prefLabel "Viewer"@en ;
    skos:altLabel "Read only"@en ;
    skos:definition "A member role whose holder may read the organization's records and write none."@en ;
    skos:notation "viewer" ;
    skos:inScheme inv:MemberRoleScheme ;
    skos:topConceptOf inv:MemberRoleScheme .

inv:MembershipStatusScheme-active a skos:Concept ;
    skos:prefLabel "Active"@en ;
    skos:definition "A membership status in which the person may act in the workspace the membership lets them act in."@en ;
    skos:notation "active" ;
    skos:inScheme inv:MembershipStatusScheme ;
    skos:topConceptOf inv:MembershipStatusScheme .

inv:MembershipStatusScheme-pending a skos:Concept ;
    skos:prefLabel "Pending"@en ;
    skos:altLabel "Invited"@en ;
    skos:definition "A membership status in which the person was invited and has not yet accepted, and cannot yet act under the membership."@en ;
    skos:notation "pending" ;
    skos:inScheme inv:MembershipStatusScheme ;
    skos:topConceptOf inv:MembershipStatusScheme .

inv:MembershipStatusScheme-revoked a skos:Concept ;
    skos:prefLabel "Revoked"@en ;
    skos:definition "A membership status in which the membership no longer lets, or will never let, the person act and is not made active again, its row kept so the audit trail still names it."@en ;
    skos:notation "revoked" ;
    skos:inScheme inv:MembershipStatusScheme ;
    skos:topConceptOf inv:MembershipStatusScheme .

inv:MembershipStatusScheme-suspended a skos:Concept ;
    skos:prefLabel "Suspended"@en ;
    skos:definition "A membership status in which the person may not act in the workspace the membership lets them act in, the history kept, and from which the membership can be made active again."@en ;
    skos:notation "suspended" ;
    skos:inScheme inv:MembershipStatusScheme ;
    skos:topConceptOf inv:MembershipStatusScheme .

inv:ModelCallPurposeScheme-check a skos:Concept ;
    skos:prefLabel "Key check"@en ;
    skos:definition "A model call purpose in which the app checks that the model key works."@en ;
    skos:notation "check" ;
    skos:inScheme inv:ModelCallPurposeScheme ;
    skos:topConceptOf inv:ModelCallPurposeScheme .

inv:ModelCallPurposeScheme-suggest a skos:Concept ;
    skos:prefLabel "Import suggestions"@en ;
    skos:definition "A model call purpose in which the app asks for proposals for the rows of an import."@en ;
    skos:notation "suggest" ;
    skos:inScheme inv:ModelCallPurposeScheme ;
    skos:topConceptOf inv:ModelCallPurposeScheme .

inv:ModelCallPurposeScheme-view a skos:Concept ;
    skos:prefLabel "Table request"@en ;
    skos:definition "A model call purpose in which the table assistant reads a request in words."@en ;
    skos:notation "view" ;
    skos:inScheme inv:ModelCallPurposeScheme ;
    skos:topConceptOf inv:ModelCallPurposeScheme .
