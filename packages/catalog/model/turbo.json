{
  "$schema": "../../../node_modules/turbo/schema.json",
  "extends": ["//"],
  "tasks": {
    // The fast tests read one file outside the package: the table of rules in docs/verify.md, which a test holds
    // against the lock (`test/Proving.test.ts`). Named here, or an edit to the page replays an old pass.
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vitest.shared.ts",
        "$TURBO_ROOT$/vitest.retries.ts",
        "$TURBO_ROOT$/docs/verify.md"
      ]
    },
    // The proofs of the review's model. A proof reads the model's own blocks (the aggregates, the decisions, who is
    // asking and the values they share), the kernel those blocks import from, how the code is compiled, and the
    // pinned library; turbo adds the versions the lockfile resolves for this package (Effect, the solver, the
    // parser). The vendored kit the kernel is built on comes with the kernel's `transit`, which folds the source of
    // every package the kernel depends on into this task's hash: nothing else brings it, and without that edge an
    // edit to `@beep/schema` would replay an old proof. It is replayed until one of
    // them changes, or the limits and retries its vitest config takes from the root: an edit to a handler, a store or
    // a screen's rule of this package does not run the proofs again.
    "prove": {
      "dependsOn": ["//#patches:installed", "@inventory/kernel#transit"],
      "inputs": [
        "package.json",
        "turbo.json",
        "tsconfig.json",
        "vitest.config.ts",
        "src/**/*.aggregate.ts",
        "src/**/*.decision.ts",
        "src/Actor/**",
        "src/Review/Change.schema.ts",
        "test/**/*.prove.test.ts",
        "test/proving.ts",
        "$TURBO_ROOT$/packages/kernel/package.json",
        "$TURBO_ROOT$/packages/kernel/src/**",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/vendor/alchemy/*.tgz",
        "$TURBO_ROOT$/vitest.shared.ts",
        "$TURBO_ROOT$/vitest.retries.ts"
      ],
      "outputs": []
    },
    // The search of the whole model: the same blocks and the model that joins them, its own test, and the lock
    // file that keeps the rules as written.
    "verify": {
      // Verify reads these two: under CI it writes no lock and refuses a rule the lock does not list, and with
      // UPDATE_VERIFY_LOCK=1 it locks every rule as written and passes. Both are in the hash, so a run under one is
      // never replayed as a run under another.
      "env": ["CI", "UPDATE_VERIFY_LOCK"],
      "dependsOn": ["//#patches:installed", "@inventory/kernel#transit"],
      "inputs": [
        "package.json",
        "turbo.json",
        "tsconfig.json",
        "vitest.config.ts",
        "src/**/*.aggregate.ts",
        "src/**/*.decision.ts",
        "src/**/*.model.ts",
        "src/Actor/**",
        "src/Review/Change.schema.ts",
        "test/**/*.verify.test.ts",
        "test/**/*.lock.json",
        "$TURBO_ROOT$/packages/kernel/package.json",
        "$TURBO_ROOT$/packages/kernel/src/**",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/vendor/alchemy/*.tgz",
        "$TURBO_ROOT$/vitest.shared.ts",
        "$TURBO_ROOT$/vitest.retries.ts"
      ],
      "outputs": []
    },
    // The mutants of the model (mutants/README.md): each one change to a `decide`, run against its proof and the
    // stories, which must notice it. The sample is fast and in `bun run check:full`; all of them run every night.
    // Both read what the proofs read, the stories and the mutants themselves, and are replayed until one changes.
    // The contract's `transit` brings what the contract is built on, as the kernel's does for the kit.
    "mutants:sample": {
      "dependsOn": ["//#patches:installed", "@inventory/kernel#transit", "@inventory/catalog-contract#transit"],
      "inputs": [
        "package.json",
        "turbo.json",
        "tsconfig.json",
        "vitest.config.ts",
        "src/**/*.aggregate.ts",
        "src/**/*.decision.ts",
        "src/Actor/**",
        "src/Review/Change.schema.ts",
        "test/proving.ts",
        "$TURBO_ROOT$/packages/kernel/package.json",
        "$TURBO_ROOT$/packages/kernel/src/**",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/vendor/alchemy/*.tgz",
        "test/**/*.story.test.ts",
        "test/**/*.prove.test.ts",
        "mutants/**",
        "src/**/*.model.ts",
        "$TURBO_ROOT$/packages/catalog/contract/package.json",
        "$TURBO_ROOT$/packages/catalog/contract/src/**",
        "$TURBO_ROOT$/vitest.shared.ts",
        "$TURBO_ROOT$/vitest.retries.ts"
      ],
      "outputs": []
    },
    "mutants": {
      "dependsOn": ["//#patches:installed", "@inventory/kernel#transit", "@inventory/catalog-contract#transit"],
      "inputs": [
        "package.json",
        "turbo.json",
        "tsconfig.json",
        "vitest.config.ts",
        "src/**/*.aggregate.ts",
        "src/**/*.decision.ts",
        "src/Actor/**",
        "src/Review/Change.schema.ts",
        "test/proving.ts",
        "$TURBO_ROOT$/packages/kernel/package.json",
        "$TURBO_ROOT$/packages/kernel/src/**",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/vendor/alchemy/*.tgz",
        "test/**/*.story.test.ts",
        "test/**/*.prove.test.ts",
        "mutants/**",
        "src/**/*.model.ts",
        "$TURBO_ROOT$/packages/catalog/contract/package.json",
        "$TURBO_ROOT$/packages/catalog/contract/src/**",
        "$TURBO_ROOT$/vitest.shared.ts",
        "$TURBO_ROOT$/vitest.retries.ts"
      ],
      "outputs": []
    }
  }
}
