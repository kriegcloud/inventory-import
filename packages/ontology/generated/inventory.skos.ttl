inv:AccountStatusScheme a skos:ConceptScheme ;
    skos:prefLabel "Account status"@en ;
    skos:definition "A controlled vocabulary of whether the tenant still trades with a party it holds a record of or has set that record aside."@en .

inv:ContactPointKindScheme a skos:ConceptScheme ;
    skos:prefLabel "Contact point kind"@en ;
    skos:definition "A controlled vocabulary of the kinds of electronic address at which a party is reached."@en .

inv:ContactPurposeScheme a skos:ConceptScheme ;
    skos:prefLabel "Contact purpose"@en ;
    skos:definition "A controlled vocabulary of the purposes for which a party is reached or served: on a contact assignment, the purpose of one person at one account; on a postal address, a use its record types it for."@en .

inv:ContactTypeScheme a skos:ConceptScheme ;
    skos:prefLabel "Contact type"@en ;
    skos:definition "A controlled vocabulary of the kinds a tenant files its contacts under, one per contact, apart from any purpose a contact is reached for."@en .

inv:GrantScopeKindScheme a skos:ConceptScheme ;
    skos:prefLabel "Grant scope kind"@en ;
    skos:definition "A controlled vocabulary of the extents a grant of access covers: a whole organization, one location, or one field."@en .

inv:IdentityOutcomeScheme a skos:ConceptScheme ;
    skos:prefLabel "Identity outcome"@en ;
    skos:definition "A controlled vocabulary of what an identity decision finds about two source records a tenant holds that may be one party."@en .

inv:MemberRoleScheme a skos:ConceptScheme ;
    skos:prefLabel "Member role"@en ;
    skos:definition "A controlled vocabulary of the access levels a member holds in an organization, ranked by what each may do."@en .

inv:MembershipStatusScheme a skos:ConceptScheme ;
    skos:prefLabel "Membership status"@en ;
    skos:definition "A controlled vocabulary of the stages a person's membership of a tenant passes through, from invited to revoked."@en .

inv:ModelCallPurposeScheme a skos:ConceptScheme ;
    skos:prefLabel "Model call purpose"@en ;
    skos:definition "A controlled vocabulary of what a call to a language model is made for, each call drawn from the day's allowance."@en .

inv:AccountStatusScheme-active a skos:Concept ;
    skos:prefLabel "Active"@en ;
    skos:definition "An account status in which the tenant still trades with the party."@en ;
    skos:notation "active" ;
    skos:inScheme inv:AccountStatusScheme ;
    skos:topConceptOf inv:AccountStatusScheme .

inv:AccountStatusScheme-archived a skos:Concept ;
    skos:prefLabel "Archived"@en ;
    skos:definition "An account status in which the tenant has set the party's record aside and keeps it only for past records."@en ;
    skos:notation "archived" ;
    skos:inScheme inv:AccountStatusScheme ;
    skos:topConceptOf inv:AccountStatusScheme .

inv:ContactPointKindScheme-email a skos:Concept ;
