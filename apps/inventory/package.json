{
  "name": "@inventory/app",
  "version": "0.6.1",
  "private": true,
  "description": "Bulk import of inventory items from a messy .csv or .xlsx, with a review you can trust",
  "type": "module",
  "scripts": {
    "predev": "node scripts/migrate-local.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-production-identity.mjs",
    "build:report": "BUNDLE_REPORT=1 vite build && node scripts/bundle-report.mjs",
    "typecheck": "tsrs -b --fast",
    "test": "vitest run --project fast",
    "lint": "oxlint --quiet; lint=$?; oxlint --disable-nested-config --deny-warnings -c ../../.oxlintrc.shadcn.json src/web && exit $lint",
    "lint:shadcn": "oxlint --disable-nested-config --deny-warnings -c ../../.oxlintrc.shadcn.json src/web",
    "preview": "tsc -b && vite build && node scripts/check-production-identity.mjs && vite preview",
    "db:migrate": "node scripts/migrate-local.mjs",
    "db:reset": "node -e \"require('node:fs').rmSync('.wrangler/state',{recursive:true,force:true})\" && node scripts/migrate-local.mjs",
    "deploy": "tsc -b && vite build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "lighthouse": "bash scripts/lighthouse.sh",
    "deploy:setup": "node scripts/deploy-setup.mjs",
    "dev:portless": "node scripts/migrate-local.mjs && portless inventory vite",
    "dev:https": "node scripts/migrate-local.mjs && node scripts/dev-https.mjs",
    "typecheck:tsc": "effect-tsgo tsc -b",
    "check:strict": "node ../../scripts/check-strict.mjs strict-ceiling.json",
    "telemetry": "node scripts/telemetry.mjs",
    "telemetry:down": "node scripts/telemetry.mjs down",
    "auth:schema": "node scripts/auth-schema.mjs",
    "check": "tsrs -b --fast && node ../../scripts/check-strict.mjs strict-ceiling.json",
    "test:slow": "vitest run --project slow",
    "test:all": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@beep/better-auth": "workspace:*",
    "@beep/csv": "workspace:*",
    "@beep/d1": "workspace:*",
    "@beep/openrouter": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@effect/sql-d1": "4.1.4",
    "@floating-ui/react-dom": "^2.1.9",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hookform/resolvers": "^7.0.6",
    "@inventory/kernel": "workspace:*",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "better-auth": "1.7.22",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "effect": "4.1.4",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.72.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-resizable-panels": "^4.22.0",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/workers-types": "^5.20261113.1",
    "@effect/tsgo": "0.70.0",
    "@effect/vitest": "4.1.4",
    "@shadcn/lint": "0.2.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/compression": "^1.8.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "compression": "1.8.2",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "react-grab": "^0.2.0",
    "rollup-plugin-visualizer": "7.0.1",
    "tailwindcss": "^4.3.5",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  }
}
