+/**
+ * A rule's text. One written as a name (`{ Rule }`, `Rule: Rule`) or as a member of a file read as a namespace
+ * (`Rule: Rules.Rule`) is the text of what that name is declared as, in the file that declares it, through the
+ * imports that give it: a rule moved to a file of its own is the rule it was, and a change to it there is a change.
+ */
+const ruleText = (modules, definition, node) => {
+  let module = definition.module;
+  let name = node.type === "Identifier" ? node.name : undefined;
+  if (
+    node.type === "MemberExpression" &&
+    !node.computed &&
+    node.object.type === "Identifier" &&
+    node.property.type === "Identifier" &&
+    !module.declarations.has(node.object.name)
+  ) {
+    const held = module.imports.get(node.object.name);
+    const file = held?.imported === "*" ? module.resolved.get(held.specifier) : undefined;
+    const next = modules.find((m) => m.path === file);
+    if (next) {
+      module = next;
+      name = node.property.name;
+    }
+  }
+  for (let hops = 0; name !== undefined && hops < 16; hops++) {
+    const declaration = module.declarations.get(name);
+    if (declaration?._tag === "Const" && declaration.init)
+      return module.source.slice(declaration.init.start, declaration.init.end);
+    if (declaration) break;
+    const imported = module.imports.get(name);
+    if (!imported || imported.imported === "*") break;
+    const file = module.resolved.get(imported.specifier);
+    const next = modules.find((m) => m.path === file);
+    if (!next) break;
+    module = next;
+    name = imported.imported;
+  }
+  return Paths.textOf(definition, node);
+};
