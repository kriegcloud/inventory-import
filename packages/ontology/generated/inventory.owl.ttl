dcterms:source a owl:AnnotationProperty .

skos:altLabel a owl:AnnotationProperty .

skos:definition a owl:AnnotationProperty .

skos:prefLabel a owl:AnnotationProperty .

gist:Address a owl:Class ;
    rdfs:subClassOf gist:Content .

gist:Assignment a owl:Class ;
    rdfs:subClassOf gist:TemporalRelation .

gist:Content a owl:Class ;
    owl:disjointWith gist:Organization ,
        gist:PhysicalIdentifiableItem .

gist:Determination a owl:Class ;
    rdfs:subClassOf gist:Event .

gist:ElectronicAddress a owl:Class ;
