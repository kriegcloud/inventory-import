@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://example.org/inventory-import/taxonomy> a owl:Ontology ;
    owl:versionIRI <https://example.org/inventory-import/taxonomy/0.1.0> ;
    owl:versionInfo "0.1.0" .

inv:GrantScopeKindScheme a skos:ConceptScheme ;
    skos:prefLabel "Grant scope kind"@en ;
    skos:definition "A controlled vocabulary of the extents a grant of access covers: a whole organization, one location, or one field."@en .

inv:MemberRoleScheme a skos:ConceptScheme ;
    skos:prefLabel "Member role"@en ;
    skos:definition "A controlled vocabulary of the access levels a member holds in an organization, ranked by what each may do."@en .

inv:GrantScopeKindScheme-organization a skos:Concept ;
    skos:prefLabel "Whole organization"@en ;
    skos:altLabel "Tenant"@en ;
    skos:definition "A grant scope kind in which the grant covers every record of one organization."@en ;
    skos:notation "organization" ;
    skos:inScheme inv:GrantScopeKindScheme ;
    skos:topConceptOf inv:GrantScopeKindScheme .

inv:MemberRoleScheme-admin a skos:Concept ;
    skos:prefLabel "Admin"@en ;
    skos:altLabel "Administrator"@en ;
    skos:definition "A member role whose holder may read and write the organization's records and add, change and remove its people."@en ;
    skos:notation "admin" ;
    skos:inScheme inv:MemberRoleScheme ;
    skos:topConceptOf inv:MemberRoleScheme .

inv:MemberRoleScheme-editor a skos:Concept ;
    skos:prefLabel "Editor"@en ;
    skos:definition "A member role whose holder may read and write the organization's records but not manage its people."@en ;
    skos:notation "editor" ;
    skos:inScheme inv:MemberRoleScheme ;
    skos:topConceptOf inv:MemberRoleScheme .

inv:MemberRoleScheme-viewer a skos:Concept ;
    skos:prefLabel "Viewer"@en ;
    skos:altLabel "Read only"@en ;
    skos:definition "A member role whose holder may read the organization's records and write none."@en ;
    skos:notation "viewer" ;
    skos:inScheme inv:MemberRoleScheme ;
    skos:topConceptOf inv:MemberRoleScheme .
