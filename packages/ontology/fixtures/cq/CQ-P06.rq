# CQ-P06: Who are the members of this organization and which role does each hold?
# The role is read through the grant and in no other way. "This organization" is a value of ?tenant. The name is the
# person's (decision 133); the email is the sign-in account's (decision 134), and a member with no account is listed
# with none.
# Each type step walks down the subclasses (decision 27), so a node typed by a subclass is found too.
PREFIX inv: <https://example.org/inventory-import/ontology/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?tenant ?person ?name ?member ?email ?role
WHERE {
  ?member rdf:type/rdfs:subClassOf* inv:Member ;
          inv:membershipIn ?tenant ;
          inv:membershipOf ?person .
  ?person rdf:type/rdfs:subClassOf* inv:Person ;
          inv:name ?name .
  OPTIONAL {
    ?member inv:memberAccount ?account .
    ?account rdf:type/rdfs:subClassOf* inv:SignInAccount ;
             inv:accountEmail ?email .
  }
  ?grant rdf:type/rdfs:subClassOf* inv:Grant ;
         inv:grantedTo ?member ;
         inv:grantScope inv:GrantScopeKindScheme-organization ;
         inv:grantsRole ?role .
}
ORDER BY ?tenant ?member
