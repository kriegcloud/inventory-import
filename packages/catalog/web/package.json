{
  "name": "@inventory/catalog-web",
  "version": "0.0.0",
  "private": true,
  "description": "The catalog's screens: the import of a file in four steps, the Items table with its editor and its assistant, and the controllers and readers behind them",
  "license": "MIT",
  "type": "module",
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    "./Catalog": "./src/Catalog.runtime.ts",
    "./Keys": "./src/Catalog.keys.ts",
    "./ImportPage": "./src/ImportPage.screen.tsx",
    "./UploadStep": "./src/UploadStep.screen.tsx",
    "./MatchStep": "./src/MatchStep.screen.tsx",
    "./ReviewStep": "./src/ReviewStep.screen.tsx",
    "./ResultStep": "./src/ResultStep.screen.tsx",
    "./ImportReview": "./src/ImportReview.controller.ts",
    "./PastImports": "./src/PastImports.screen.tsx",
    "./ImportWords": "./src/internal/format.tsx",
    "./ItemText": "./src/internal/itemText.ts",
    "./CellDrafts": "./src/internal/cellDrafts.ts",
    "./ItemsPage": "./src/ItemsPage.screen.tsx",
    "./ItemEditor": "./src/ItemEditor.screen.tsx",
    "./TableAssistant": "./src/TableAssistant.screen.tsx",
    "./Imports": "./src/Imports.atoms.ts",
    "./Upload": "./src/Upload.controller.ts",
    "./Spreadsheet": "./src/internal/spreadsheet/index.ts",
    "./SpreadsheetCsv": "./src/internal/spreadsheet/csv.ts",
    "./Conversation": "./src/Conversation.machine.ts",
    "./TableViewState": "./src/internal/view.ts",
    "./Route": "./src/internal/route.ts",
    "./AnsweredByWords": "./src/internal/answeredBy.ts",
    "./UploadMachine": "./src/Upload.machine.ts",
    "./ImportDecisions": "./src/ImportDecisions.screen.tsx",
    "./KeptNotices": "./src/KeptNotices.screen.tsx"
  },
  "scripts": {
    "check": "tsrs -p tsconfig.json && tsrs -p tsconfig.test.json && beep-cli quality strict strict-ceiling.json",
    "lint": "oxlint --quiet src; lint=$?; oxlint --disable-nested-config --deny-warnings -c ../../../.oxlintrc.shadcn.json src && exit $lint",
    "test": "vitest run --project fast",
    "fold": "vitest run --project fold"
  },
  "dependencies": {
    "@beep/csv": "workspace:*",
    "@beep/schema": "workspace:*",
    "@beep/xlsx": "workspace:*",
    "@effect/atom-react": "catalog:",
    "@inventory/catalog-contract": "workspace:*",
    "@inventory/catalog-model": "workspace:*",
    "@inventory/client": "workspace:*",
    "@inventory/kernel": "workspace:*",
    "@inventory/review": "workspace:*",
    "@inventory/ui": "workspace:*",
    "@tanstack/react-table": "catalog:",
    "effect": "catalog:",
    "lucide-react": "catalog:",
    "sonner": "catalog:"
  },
  "devDependencies": {
    "@alchemy.run/domain": "2.0.0-beta.87-734c27a",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "oxlint": "catalog:",
    "tsrs": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "beep": {
    "family": "context",
    "context": "catalog",
    "layer": "web"
  }
}
