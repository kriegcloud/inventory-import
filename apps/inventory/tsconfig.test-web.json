{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test-web.tsbuildinfo",
    "lib": ["ESNext", "DOM"],
    "module": "esnext",
    "types": ["node", "vite/client"],
    "allowArbitraryExtensions": true,
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/web/*"]
    },
    "jsx": "react-jsx"
  },
  "include": ["test/web"]
}
