{
  "name": "@inventory/catalog-model",
  "version": "0.0.0",
  "private": true,
  "description": "The catalog's rules with no SQL and no HTTP in them: reading a sheet's layout, staging and its pieces, the review of a file of items, suggestions and the table assistant's checks",
  "license": "MIT",
  "type": "module",
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    "./ItemsOfRow": "./src/Review/ItemsOfRow.context.ts",
    "./Review": "./src/Review/Review.rules.ts",
    "./SheetLayout": "./src/Reading/SheetLayout.rules.ts",
    "./Spreadsheet": "./src/Reading/Spreadsheet.rules.ts",
    "./Suggest": "./src/Suggestion/Suggest.rules.ts",
    "./TableViewRules": "./src/Assistant/TableView.rules.ts",
    "./Upload": "./src/Staging/Upload.rules.ts",
    "./ImportStore": "./src/Import/ImportStore.store.ts",
    "./ItemStore": "./src/Item/ItemStore.store.ts",
    "./ImportsHandler": "./src/Import/Imports.handler.ts",
    "./Rematch": "./src/Import/Rematch.rules.ts",
    "./ItemsHandler": "./src/Item/Items.handler.ts",
    "./AssistantHandler": "./src/Assistant/Assistant.handler.ts",
    "./Ports": "./src/Catalog.ports.ts",
    "./Handlers": "./src/Catalog.handlers.ts",
    "./Confirm": "./src/Confirm/Confirm.rules.ts",
    "./Answerer": "./src/Answer/Answerer.external.ts",
    "./ModelAllowance": "./src/Answer/ModelAllowance.external.ts",
    "./SuggestionStore": "./src/Suggestion/SuggestionStore.store.ts",
    "./SuggestionsHandler": "./src/Suggestion/Suggestions.handler.ts",
    "./AssistantLog": "./src/Assistant/AssistantLog.store.ts",
    "./Memory": "./src/Catalog.memory.ts",
    "./Staging": "./src/Staging/Staging.rules.ts",
    "./Mapping": "./src/Review/Mapping.rules.ts",
    "./CellReading": "./src/Review/CellReading.rules.ts",
    "./NotImported": "./src/Review/NotImported.rules.ts",
    "./ItemSearch": "./src/Item/ItemSearch.rules.ts",
    "./ItemEdit": "./src/Item/ItemEdit.rules.ts",
    "./Actor": "./src/Actor/Actor.context.ts",
    "./ImportAggregate": "./src/Import/Import.aggregate.ts",
    "./RowAggregate": "./src/Row/Row.aggregate.ts",
    "./GroupAggregate": "./src/Group/Group.aggregate.ts",
    "./Deciding": "./src/Review/Deciding.decision.ts",
    "./Undoing": "./src/Review/Undoing.decision.ts",
    "./DecidingGroup": "./src/Review/DecidingGroup.decision.ts",
    "./UndoingGroup": "./src/Review/UndoingGroup.decision.ts",
    "./ReviewChange": "./src/Review/Change.schema.ts",
    "./Model": "./src/Catalog.model.ts"
  },
  "scripts": {
    "check": "tsrs -p tsconfig.json && tsrs -p tsconfig.test.json",
    "lint": "oxlint --quiet src test",
    "test": "vitest run --project fast",
    "prove": "vitest run --project prove",
    "verify": "vitest run --project verify",
    "mutants": "python3 -I mutants/run.py --all --jobs 2",
    "mutants:sample": "python3 -I mutants/run.py --sample"
  },
  "dependencies": {
    "@alchemy.run/domain": "2.0.0-beta.87-734c27a",
    "@beep/schema": "workspace:*",
    "@inventory/catalog-contract": "workspace:*",
    "@inventory/kernel": "workspace:*",
    "alchemy": "2.0.0-beta.87-734c27a",
    "effect": "4.1.5"
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.5",
    "@effect/vitest": "4.1.5",
    "@types/node": "^22.20.5",
    "vitest": "^5.1.0"
  },
  "beep": {
    "family": "context",
    "context": "catalog",
    "layer": "model"
  }
}
