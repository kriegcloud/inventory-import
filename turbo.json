{
  "$schema": "./node_modules/turbo/schema.json",
  "futureFlags": { "globalConfiguration": true },
  "global": {
    // Every task's hash starts from these. A package's own package.json is already in its inputs.
    "inputs": [".bun-version", "bunfig.toml"],
    // Tasks see the whole environment (the slow tests start workerd and wrangler, which read many variables); none
    // of it changes a cached result, so none of it is hashed.
    "envMode": "loose"
  },
  "tasks": {
    // A task with no script anywhere: depending on `^transit` folds every workspace dependency's source into a
    // task's hash, so a cached check cannot survive a change in a package it imports. Packages export TypeScript
    // source and never build, so `check` has no `^build` edge to do this.
    "transit": { "dependsOn": ["^transit"], "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!test/**"] },
    // Type-check with the Effect diagnostics.
    // A package's check may run the repository's own commands (quality strict, laws exports): their source is an input.
    "check": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/tooling/tool/cli/src/**"],
      "outputs": []
    },
    // oxlint, and the design-system lint in packages with screens.
    "lint": { "outputs": [] },
    // The fast tests. Their limits are the root's (vitest.shared.ts), which every package's vitest.config.ts imports.
    "test": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.shared.ts"],
      "outputs": []
    },
    // The slow tests: workerd, a real D1 database and sign-in. One suite calls a live service, so never cached.
    "test:slow": { "dependsOn": ["transit"], "cache": false },
    // The production build and its identity check.
    "build": { "dependsOn": ["transit"], "outputs": ["dist/**"] },
    "dev": { "cache": false, "persistent": true },
    // Repository checks: root scripts that do not call turbo.
    // Every file but an experiment of the scratchpad: the formatter leaves those alone (.oxfmtrc.json), and an
    // experiment that is not formatted, or does not parse, fails nothing here.
    "//#format:check": { "inputs": ["$TURBO_DEFAULT$", "!scratchpad/experiments/**"], "outputs": [] },
    // Vendored kit packages still match the beep-effect files they were copied from (`beep vendor check`).
    "//#vendor:check": {
      "inputs": [
        "packages/**/vendor.json",
        "packages/**/package.json",
        "packages/**/src/**",
        "packages/**/test/**",
        "packages/tooling/tool/cli/src/**"
      ],
      "outputs": []
    },
    // The stage C ceilings of the packages with screens add up to at most 678 (`beep quality ceilings`).
    "//#ceilings:check": {
      "inputs": ["apps/*/strict-ceiling.json", "packages/**/strict-ceiling.json", "packages/tooling/tool/cli/src/**"],
      "outputs": []
    },
    // Which package may import which (`beep laws boundaries`): every package.json and every import under src and test.
    "//#boundaries:check": {
      // What the law reads: every manifest, every file under src and test, and for the scratchpad's rule also each
      // workspace's scripts, its root files and stylesheets, and the repository's own root files and manifest.
      "inputs": [
        "package.json",
        "*.{ts,tsx,mts,cts,js,mjs,cjs}",
        "apps/**/package.json",
        "apps/**/*.{ts,tsx,mts,cts,js,mjs,cjs,css}",
        "packages/**/package.json",
        "packages/**/*.{ts,tsx,mts,cts,js,mjs,cjs,css}",
        "scratchpad/package.json",
        "packages/tooling/tool/cli/src/**",
        "!**/node_modules/**",
        "!**/dist/**",
        "!**/.wrangler/**"
      ],
      "outputs": []
    },
    // Every package with screens is in both lists Tailwind reads class names from (`beep laws screens`).
    "//#screens:check": {
      "inputs": [
        "apps/inventory/package.json",
        "apps/inventory/src/web/index.css",
        "apps/inventory/vite.config.ts",
        "packages/**/package.json",
        "packages/**/src/**/*.tsx",
        "packages/tooling/tool/cli/src/**"
      ],
      "outputs": []
    },
    // Every ref is a DOM ref or a callback that stays the same across draws (`beep laws ref-callbacks`).
    // Its inputs are the law's own pathspec: every .tsx git would commit, the vendored kit, the skills and the
    // scratchpad left out; and
    // every package.json, whose exports name the modules of hooks.
    "//#refs:check": {
      "inputs": [
        "**/*.tsx",
        "!**/node_modules/**",
        "!packages/ui/src/components/**",
        "!packages/ui/src/hooks/**",
        "!.agents/**",
        "!scratchpad/**",
        "apps/**/package.json",
        "packages/**/package.json",
        "packages/tooling/tool/cli/src/**"
      ],
      "outputs": []
    },
    // No `_tag` is told apart or built by hand in our own code and every test (`beep laws tags`), with no file
    // excepted: a count per file would let one hand-written tag be swapped for another.
    "//#tags:check": {
      "inputs": [
        "apps/*/src/**/*.{ts,tsx}",
        "apps/*/test/**/*.{ts,tsx}",
        "packages/**/src/**/*.{ts,tsx}",
        "packages/**/test/**/*.{ts,tsx}",
        "packages/client/**/*.{ts,tsx}",
        "packages/review/**/*.{ts,tsx}",
        "packages/ui/**/*.{ts,tsx}",
        "packages/**/vendor.json",
        "packages/tooling/tool/cli/src/**"
      ],
      "outputs": []
    },
    // Every Effect import from its own path under its own name (`beep laws effect-imports`,
    // docs/standards/effect-imports.md): code, the examples in its comments, and the standing documents.
    "//#imports:check": {
      "inputs": [
        "apps/**/*.{ts,tsx,mts,mjs}",
        "packages/**/*.{ts,tsx,mts,mjs}",
        "packages/**/vendor.json",
        "*.md",
        "docs/**/*.md",
        ".claude/agents/*.md",
        "bun.lock"
      ],
      "outputs": []
    },
    // Every version and date written in more than one place equals its one source (`beep version-sync`): the
    // package.json files, the workflows, the standing documents, the wrangler files, the stacks and the CLI's own
    // source. The installed @effect/tsgo it compares a `$schema` with is hashed through bun.lock.
    "//#version-sync": {
      "inputs": [
        "package.json",
        "apps/**/package.json",
        "packages/**/package.json",
        ".github/workflows/**",
        "CLAUDE.md",
        "AGENTS.md",
        "README.md",
        "docs/**/*.md",
        ".claude/agents/*.md",
        "tsconfig*.json",
        "apps/**/tsconfig*.json",
        "packages/**/tsconfig*.json",
        "apps/**/wrangler*.jsonc",
        "packages/**/wrangler*.jsonc",
        "packages/**/src/**/*.ts",
        "vendor/alchemy/sources.json",
        "scratchpad/package.json",
        "bun.lock",
        "!**/node_modules/**"
      ],
      "outputs": []
    },
    // The lists and paths that follow from the workspaces are what the workspaces say (`beep config-sync --check`):
    // every configuration file of the root and of each package, each package's scripts, and what a package holds
    // (a vitest.config.ts, a vendor.json, a ceiling file). An installed file a `$schema` names is hashed through
    // bun.lock.
    "//#config-sync:check": {
      "inputs": [
        "*.{json,jsonc}",
        "scratchpad/package.json",
        "scratchpad/tsconfig*.json",
        ".oxlintrc*.json",
        ".oxfmtrc.json",
        ".syncpackrc.json",
        "apps/**/*.{json,jsonc}",
        "apps/**/.oxlintrc*.json",
        "apps/**/vitest.config.ts",
        "packages/**/*.{json,jsonc}",
        "packages/**/.oxlintrc*.json",
        "packages/**/vitest.config.ts",
        "packages/tooling/tool/cli/src/**",
        "bun.lock",
        "!**/node_modules/**",
        "!**/dist/**",
        "!**/.wrangler/**",
        "!**/.turbo/**"
      ],
      "outputs": []
    },
    // No deprecated API is used (`beep laws deprecated-apis`), read from every file's types: a new `@deprecated` in one
    // file, in a tsconfig's reach or in an installed package changes the answer for a file that did not change. So every
    // code file and tsconfig is an input, in a folder nobody listed too, with every workspace's manifest and what is
    // installed: the lockfile, and the manifest of every installed package in the root's node_modules, nested ones
    // included, so an install that has fallen behind the lockfile is not answered from one that had not. Turbo applies
    // every `!` to every line above it, so node_modules is not excluded whole: only its code files and tsconfigs are.
    // Left out by name: what git ignores and the law does not read (`.agents`, the scratchpad, and `.claude`, which
    // in the main checkout holds every other checkout of this repository).
    "//#deprecated:check": {
      "inputs": [
        ".oxlintrc.deprecated-apis.json",
        ".gitignore",
        "**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
        "**/tsconfig*.json",
        "package.json",
        "apps/**/package.json",
        "packages/**/package.json",
        "!node_modules/**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
        "!node_modules/**/tsconfig*.json",
        "!apps/**/{node_modules,dist,.wrangler,.turbo}/**",
        "!packages/**/{node_modules,dist,.turbo}/**",
        "!{.claude,.codex,.agents,.turbo,.scratch,.wrangler,.alchemy,.taste-skill,.session,scratchpad}/**",
        "bun.lock",
        "node_modules/*/package.json",
        "node_modules/@*/*/package.json"
      ],
      "outputs": []
    },
    // The root's own .ts files and each package's vitest.config.ts type-check (tsconfig.config.json). Only the linter
    // above reads that project otherwise, and an import that does not resolve there would hide a deprecated call.
    "//#configs:check": {
      "inputs": [
        "tsconfig.config.json",
        "tsconfig.base.json",
        "*.ts",
        "packages/**/*.{ts,tsx}",
        "packages/**/package.json",
        "!packages/**/{node_modules,dist}/**",
        "package.json",
        "bun.lock"
      ],
      "outputs": []
    },
    // Its tests run that law with the root's own profile and the installed packages, whose deprecation notes they
    // expect word for word: the same installed manifests are inputs here.
    "@beep/repo-cli#test": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vitest.shared.ts",
        "$TURBO_ROOT$/.oxlintrc.deprecated-apis.json",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/node_modules/*/package.json",
        "$TURBO_ROOT$/node_modules/@*/*/package.json"
      ],
      "outputs": []
    },
    // bun.lock says what every package.json asks for, so CI's `bun install --frozen-lockfile` accepts it. Resolved
    // from bun's cache, never the network, and nothing is written or installed: a package.json that asks for a
    // version bun.lock does not hold fails here, before a push.
    "//#lockfile:check": {
      "inputs": [
        "package.json",
        "apps/**/package.json",
        "packages/**/package.json",
        "scratchpad/package.json",
        "bun.lock",
        "bunfig.toml",
        "!**/node_modules/**"
      ],
      "outputs": []
    },
    // Every file git would commit, so its hash is the whole repository's, the scratchpad's experiments included: a
    // key in an experiment is refused like any other, and this is the one root task an edit there re-runs.
    "//#keys:check": { "outputs": [] },
    "//#docs:check": {
      "inputs": [
        "docs/**",
        "explorations/**",
        "goals/**",
        "packages/tooling/tool/cli/src/**",
        ".agents/skills/okf-open-knowledge-format/**"
      ],
      "outputs": []
    }
  }
}
