{
  "name": "inventory",
  "private": true,
  "description": "Bulk import of inventory items from a messy .csv or .xlsx, with a review you can trust",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/catalog/*",
    "packages/access/*",
    "packages/drivers/*",
    "packages/foundation/*/*",
    "packages/tooling/*/*",
    "scratchpad"
  ],
  "type": "module",
  "scripts": {
    "check": "turbo run check lint test prove //#format:check //#docs:check //#keys:check //#vendor:check //#ceilings:check //#boundaries:check //#screens:check //#refs:check //#tags:check //#imports:check //#deprecated:check //#configs:check //#version-sync //#config-sync:check",
    "check:full": "turbo run check lint test prove verify fold mutants:sample test:slow build //#format:check //#docs:check //#keys:check //#vendor:check //#ceilings:check //#boundaries:check //#screens:check //#refs:check //#tags:check //#imports:check //#deprecated:check //#configs:check //#version-sync //#config-sync:check",
    "check:ci": "turbo run check lint test test:slow build //#format:check //#docs:check //#keys:check //#vendor:check //#ceilings:check //#boundaries:check //#screens:check //#refs:check //#tags:check //#imports:check //#deprecated:check //#configs:check //#version-sync //#config-sync:check",
    "beep": "bun run packages/tooling/tool/cli/src/bin.ts --",
    "dev": "bun run --cwd apps/inventory dev",
    "build": "turbo run build",
    "preview": "bun run --cwd apps/inventory preview",
    "test": "turbo run test prove verify test:slow",
    "lint": "turbo run lint",
    "typecheck": "turbo run check",
    "db:reset": "bun run --cwd apps/inventory db:reset",
    "auth:schema": "bun run --cwd apps/inventory auth:schema",
    "telemetry": "bun run --cwd apps/inventory telemetry",
    "telemetry:down": "bun run --cwd apps/inventory telemetry:down",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "docs:check": "bun packages/tooling/tool/cli/src/bin.ts docs check",
    "deps:lint": "syncpack lint",
    "deps:outdated": "syncpack update --check",
    "proofs": "turbo run prove verify fold mutants:sample",
    "proofs:nightly": "turbo run prove verify fold mutants",
    "deps:update": "bun packages/tooling/tool/cli/src/bin.ts deps update",
    "version-sync": "bun packages/tooling/tool/cli/src/bin.ts version-sync",
    "config-sync": "bun packages/tooling/tool/cli/src/bin.ts config-sync",
    "config-sync:check": "bun packages/tooling/tool/cli/src/bin.ts config-sync --check",
    "scratch:new": "bun packages/tooling/tool/cli/src/bin.ts scratch new",
    "scratch:list": "bun packages/tooling/tool/cli/src/bin.ts scratch list",
    "scratch:check": "bun packages/tooling/tool/cli/src/bin.ts scratch check",
    "scratch:test": "bun run --cwd scratchpad tests",
    "scratch:serve": "bun run --cwd scratchpad serve",
    "scratch:graduate": "bun packages/tooling/tool/cli/src/bin.ts scratch graduate",
    "scratch:drop": "bun packages/tooling/tool/cli/src/bin.ts scratch drop",
    "alchemy:repin": "python3 vendor/alchemy/repin.py",
    "alchemy:check": "python3 vendor/alchemy/repin.py --check",
    "prepare": "effect-tsgo patch --typescript --oxlint --tsrs",
    "keys:check": "bun packages/tooling/tool/cli/src/bin.ts laws keys",
    "vendor:check": "bun packages/tooling/tool/cli/src/bin.ts vendor check",
    "ceilings:check": "bun packages/tooling/tool/cli/src/bin.ts quality ceilings",
    "boundaries:check": "bun packages/tooling/tool/cli/src/bin.ts laws boundaries",
    "screens:check": "bun packages/tooling/tool/cli/src/bin.ts laws screens",
    "refs:check": "bun packages/tooling/tool/cli/src/bin.ts laws ref-callbacks",
    "tags:check": "bun packages/tooling/tool/cli/src/bin.ts laws tags",
    "imports:check": "bun packages/tooling/tool/cli/src/bin.ts laws effect-imports",
    "deprecated:check": "bun packages/tooling/tool/cli/src/bin.ts laws deprecated-apis",
    "configs:check": "tsrs -p tsconfig.config.json --noEmit",
    "imports:fix": "bun packages/tooling/tool/cli/src/bin.ts laws effect-imports --write"
  },
  "devDependencies": {
    "@beep/repo-cli": "workspace:*",
    "@effect/tsgo": "0.73.2",
    "oxfmt": "^0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "syncpack": "^15.3.3",
    "tsrs": "7.1.0-beta.tsrs3",
    "turbo": "2.11.11",
    "typescript": "~7.0.2"
  },
  "overrides": {
    "@alchemy.run/acme": "file:vendor/alchemy/alchemy.run-acme-734c27a.tgz",
    "@alchemy.run/cloudflare": "file:vendor/alchemy/alchemy.run-cloudflare-734c27a.tgz",
    "@alchemy.run/cloudflare-runtime": "file:vendor/alchemy/alchemy.run-cloudflare-runtime-734c27a.tgz",
    "@alchemy.run/docker": "file:vendor/alchemy/alchemy.run-docker-734c27a.tgz",
    "@alchemy.run/domain": "file:vendor/alchemy/alchemy.run-domain-734c27a.tgz",
    "@alchemy.run/github": "file:vendor/alchemy/alchemy.run-github-734c27a.tgz",
    "@alchemy.run/node-utils": "file:vendor/alchemy/alchemy.run-node-utils-734c27a.tgz",
    "@alchemy.run/sql": "file:vendor/alchemy/alchemy.run-sql-734c27a.tgz",
    "@distilled.cloud/acme": "file:vendor/alchemy/distilled.cloud-acme-734c27a.tgz",
    "@distilled.cloud/aws": "file:vendor/alchemy/distilled.cloud-aws-734c27a.tgz",
    "@distilled.cloud/aws4signer": "file:vendor/alchemy/distilled.cloud-aws4signer-734c27a.tgz",
    "@distilled.cloud/cloudflare": "file:vendor/alchemy/distilled.cloud-cloudflare-734c27a.tgz",
    "@distilled.cloud/core": "file:vendor/alchemy/distilled.cloud-core-734c27a.tgz",
    "@distilled.cloud/github": "file:vendor/alchemy/distilled.cloud-github-734c27a.tgz",
    "@distilled.cloud/iceberg": "file:vendor/alchemy/distilled.cloud-iceberg-734c27a.tgz",
    "@distilled.cloud/s3": "file:vendor/alchemy/distilled.cloud-s3-734c27a.tgz",
    "alchemy": "file:vendor/alchemy/alchemy-734c27a.tgz"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ]
}
