 /**
+ * A rule's text. One written as a name (`{ Rule }`, `Rule: Rule`) is the text of what that name is declared as, in the
+ * file that declares it, through the imports that give it: a rule moved to a file of its own is the rule it was.
+ */
+const ruleText = (modules, definition, node) => {
+    let module = definition.module;
+    let name = node.type === "Identifier" ? node.name : undefined;
+    for (let hops = 0; name !== undefined && hops < 16; hops++) {
+        const declaration = module.declarations.get(name);
+        if (declaration?._tag === "Const" && declaration.init)
+            return module.source.slice(declaration.init.start, declaration.init.end);
+        if (declaration)
+            break;
+        const imported = module.imports.get(name);
+        if (!imported || imported.imported === "*")
+            break;
+        const file = module.resolved.get(imported.specifier);
+        const next = modules.find((m) => m.path === file);
+        if (!next)
+            break;
+        module = next;
+        name = imported.imported;
+    }
+    return Paths.textOf(definition, node);
+};
