{
  "mcpServers": {
    "shadcn": {
      "command": "bunx",
      "args": ["shadcn@4.23.0", "mcp"]
    },
    "playwright": {
      "command": "bunx",
      "args": [
        "@playwright/mcp@0.0.85",
        "--headless",
        "--isolated",
        "--viewport-size",
        "1440x900",
        "--output-dir",
        ".scratch/playwright"
      ]
    },
    "better-auth": {
      "type": "http",
      "url": "https://mcp.better-auth.com/mcp"
    }
  }
}
